@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenStack Orientation="Orientation.Vertical">
	<div style="max-height: 400px; overflow-y: auto;">
		@if (Tables == null || !Tables.Any())
		{
			<p>Tidak ada tabel tersedia.</p>
		}
		else
		{
			@foreach (var table in Tables)
			{
				<div class="table-section mb-2 border rounded">
					<div class="table-header d-flex justify-content-between align-items-center p-2"
						 style="cursor: pointer; background: #f8f9fa;"
						 @onclick="@(() => ToggleCollapse(table.Name))">
						<div>
							<span class="fw-semibold">Tabel @table.Name</span>
						</div>
						<i class="material-symbols-rounded" style="@GetCollapseStyle(table.Name)">
							expand_more
						</i>
					</div>

					@if (!CollapsedTables.Contains(table.Name))
					{
						<div class="p-2 ps-4 bg-light border-top">
							@if (table.Columns == null || !table.Columns.Any())
							{
								<span class="text-muted fst-italic">Tidak ada kolom di tabel ini.</span>
							}
							else
							{
								@foreach (var column in table.Columns)
								{
									<div class="column-item mb-1 d-flex align-items-center">
										<RadzenCheckBox TValue="bool"
														Value="@SelectedTags.Contains(column.FullName)"
														Change="(args) => ToggleColumnSelection(column.FullName, args)" />
										<span class="ms-2">
											@column.DisplayName
											<span style="color: #6c757d;">(@column.Description)</span>
										</span>
									</div>
								}
							}
						</div>
					}
				</div>
			}
		}
	</div>

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Class="mt-2">
		<div>
			<span class="fw-semibold" style="font-size: 18px">
				Total kolom terpilih: <span class="text-primary ms-1">@SelectedTags.Count</span>
				@if (!IsTable)
				{
					<small class="text-muted ms-2">(maks. @MaxSelectedTags)</small>
				}
			</span>
		</div>

		<div>
			<RadzenButton Text="Update" Click="OnUpdateClick" IsBusy="@isUpdate" ButtonStyle="ButtonStyle.Primary" />
			<RadzenButton Text="Clear" Click="ClearSelectedColumn" ButtonStyle="ButtonStyle.Light" />
		</div>
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter] public Dictionary<string, List<ColumnMachine>> MachineTags { get; set; } = new();
	[Parameter] public HashSet<string> SelectedTags { get; set; } = new();
	[Parameter] public EventCallback<HashSet<string>> OnUpdate { get; set; }
	[Parameter] public bool IsTable { get; set; } = false;

	private List<TableModal> Tables { get; set; } = new();
	private HashSet<string> CollapsedTables { get; set; } = new();

	private const int MaxSelectedTags = 8;
	private bool isUpdate = false;

	protected override void OnInitialized()
	{
		Tables = MachineTags.Select(mt => new TableModal
		{
			Name = mt.Key,
			Columns = mt.Value.Select(c => new ColumnModal
			{
				FullName = $"{mt.Key}.{c.NamaTag}",
				DisplayName = c.NamaTag,
				Description = c.AliasPendek
			}).ToList()
		}).ToList();

		// Collapse semua tabel kecuali pertama
		if (Tables.Any())
			CollapsedTables = Tables.Skip(1).Select(t => t.Name).ToHashSet();
	}

	private void ToggleCollapse(string tableName)
	{
		if (CollapsedTables.Contains(tableName))
			CollapsedTables.Remove(tableName);
		else
			CollapsedTables.Add(tableName);
	}

	private string GetCollapseStyle(string tableName)
	{
		return CollapsedTables.Contains(tableName)
			? "transform: rotate(-90deg); transition: transform 0.2s;"
			: "transition: transform 0.2s;";
	}

	private void ToggleColumnSelection(string columnName, bool? isSelected)
	{
		if (isSelected == true)
		{
			// Pembatasan pemilihan kolom
			if (SelectedTags.Count >= MaxSelectedTags && !IsTable)
			{
				NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Warning,
					Summary = "Batas Maksimal Tercapai",
					Detail = $"Maksimal hanya {MaxSelectedTags} kolom yang dapat dipilih.",
					Duration = 3000
				});
				return;
			}

			SelectedTags.Add(columnName);
		}
		else
		{
			SelectedTags.Remove(columnName);
		}
	}

	private async Task OnUpdateClick()
	{
		isUpdate = true;
		StateHasChanged();

		await OnUpdate.InvokeAsync(SelectedTags);

		isUpdate = false;
		StateHasChanged();
		DialogService.Close(SelectedTags);
	}

	private void ClearSelectedColumn()
	{
		SelectedTags.Clear();
	}

	private void CloseColumnSelectorPopup()
	{
		DialogService.Close(SelectedTags);
	}
}