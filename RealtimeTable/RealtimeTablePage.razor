@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration

@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService

@inject IConfiguration Configuration
@inject IMachineService MachineService
@inject ISettingService SettingService

<RadzenRow>
	<RadzenColumn SizeMD="12">
		<div class="card border shadow-xs mb-4">
			@* Header Table *@
			<div class="card-header border-bottom pb-0">
				<div class="d-sm-flex align-items-center">
					<div>
						<h6 class="mb-0" style="font-size: 24px; font-weight: 600;">Realtime OPC Data</h6>
						<p class="text-sm">Pantau data terkini hanya dalam satu tampilan! Semua tabel, selalu update setiap saat.</p>
						@if (_data != null && _data.TryGetValue("timestamp", out var ts) && ts != null)
						{
							DateTime lastUpdated;
							if (DateTime.TryParse(ts.ToString(), out lastUpdated))
							{
								var culture = new System.Globalization.CultureInfo("id-ID");
								string hari = culture.DateTimeFormat.GetDayName(lastUpdated.DayOfWeek);
								string tanggal = lastUpdated.ToString("dd MMMM yyyy HH.mm.ss", culture);

								<p class="text-muted">
									Terakhir update: <b>@hari, @tanggal</b>
								</p>
							}
						}
						else
						{
							<p class="text-muted">
								Terakhir update: <b>Menunggu pembaruan data...</b>
							</p>
						}
						@* Interval Fetch Data *@
						<p class="text-muted">
							Fetch Data setiap: <b>@settingData.RealTimeFreq detik</b>
						</p>
					</div>
					<div class="ms-auto d-flex"></div>
				</div>
			</div>

			@* Body Table *@
			<div class="card-body px-0 py-0">
				@* Filtering Data *@
				@* <div class="border-bottom py-3 px-3">
					<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.Normal" Gap="5" Style="flex-wrap: wrap !important; margin: 1rem 0rem;">
						<RadzenFormField AllowFloatingLabel="false" Text="Pilih Tabel">
							<RadzenDropDown Data="@machineTags.Keys"
											@bind-Value="selectedTable"
											Placeholder="Pilih tabel"
											Style="width:220px"
											AllowClear="true"
											Change="@(args => { selectedColumn = null; StateHasChanged(); })" />
						</RadzenFormField>

						@if (!string.IsNullOrWhiteSpace(selectedTable) && machineTags.ContainsKey(selectedTable))
						{
							<RadzenFormField AllowFloatingLabel="false" Text="Pilih Kolom">
								<RadzenDropDown Data="@machineTags[selectedTable].Select(c => c.NamaTag)"
												@bind-Value="selectedColumn"
												Placeholder="Pilih kolom"
												Style="width:220px"
												AllowClear="true"
												Change="@(args => StateHasChanged())" />
							</RadzenFormField>
						}

						<RadzenButton Text="Hapus Filter" Icon="close" Click="() => { selectedTable = selectedColumn = null; StateHasChanged(); }" class="w-auto" />
					</RadzenStack>
				</div> *@

				<div class="table-responsive p-0">
					@* Table Realtime *@
					@if (_data != null && machineTags.Any())
					{
						@* <RadzenDataGrid Data="@GetAllTableData(machineTags)" *@
						<RadzenDataGrid Data="@GetFilteredTableData()"
										TItem="TableRealtime"
										AllowSorting="true"
										AllowVirtualization="true"
										AllowGrouping="true"
										AllGroupsExpanded="true"
										HideGroupedColumn="false"
										AllowFiltering="true"
										FilterMode="FilterMode.Simple"
										Render="@OnRender"
										Style="margin-bottom: 5rem; max-height: 500px">
							<Columns>
								<RadzenDataGridColumn TItem="TableRealtime" Property="TableName" Title="Tabel" />
								<RadzenDataGridColumn TItem="TableRealtime" Property="Column" Title="Tag Nama" />
								<RadzenDataGridColumn TItem="TableRealtime" Property="Deskripsi" Title="Deskripsi" />
								<RadzenDataGridColumn TItem="TableRealtime" Title="Nilai">
									<Template Context="data">
										<span class="@GetValueClass(data)">@data.Value</span>
									</Template>
								</RadzenDataGridColumn>
							</Columns>
						</RadzenDataGrid>
					}
					else
					{
						<p class="text-muted fst-italic">Menunggu OPC Data...</p>
					}
				</div>
			</div>
		</div>

	</RadzenColumn>
</RadzenRow>


@code {
	private Dictionary<string, List<ColumnMachine>> machineTags = new();
	private Settings settingData = new();

	// Konfigurasi SignalR
	private HubConnection? _hubConnection;
	private Dictionary<string, object>? _data;

	// Filtering
	private string? selectedTable = null;
	private string? selectedColumn = null;

	// Animasi
	private HashSet<string> animatedRows = new();
	private Dictionary<string, string> previousValues = new();
	private HashSet<string> animatedKeys = new();

	private bool isLoadingTable = false;

	protected override async Task OnInitializedAsync()
	{
		settingData = (await SettingService.GetAll()).FirstOrDefault() ?? new Settings();

		machineTags = await MachineService.Browse();
		await LoadDataRealtime();
		base.OnInitialized();
	}

	private async Task LoadDataRealtime()
	{
		try
		{
			isLoadingTable = true;
			StateHasChanged();

			string hubUrl = $"{Configuration.GetValue<string>("ApiSettings:BaseUrl")?.TrimEnd('/')}/realtimehub";

			_hubConnection = new HubConnectionBuilder()
				// .WithUrl(Navigation.ToAbsoluteUri("/realtimehub"))
				.WithUrl(hubUrl)
				.WithAutomaticReconnect()
				.Build();

			_hubConnection.On<Dictionary<string, object>>("ReceiveRealTimeData", data =>
			{
				_data = data;

				DetectValueChanges();
				InvokeAsync(StateHasChanged);

				Task.Delay(1000);
				animatedKeys.Clear();

				InvokeAsync(StateHasChanged);
			});

			await _hubConnection.StartAsync();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			isLoadingTable = false;
			StateHasChanged();
		}
	}

	// Fetch data
	private List<TableRealtime> GetAllTableData(Dictionary<string, List<ColumnMachine>> machineTags)
	{
		try
		{
			var allData = new List<TableRealtime>();

			foreach (var table in machineTags)
			{
				var tableName = table.Key;
				var columns = table.Value;

				foreach (var col in columns)
				{
					string key = $"{col.NamaTag}";
					object? value = null;

					if (_data != null)
						_data.TryGetValue(key, out value);

					allData.Add(new TableRealtime
					{
						TableName = tableName,
						Column = col.NamaTag ?? "null",
						Deskripsi = col.Deskripsi ?? "null",
						Value = value switch
						{
							null => "null",
							double d => d.ToString("N2"),
							DateTime dt => dt.ToString("dd-MM-yyyy HH:mm:ss"),
							_ => value.ToString() ?? "null"
						}
					});
				}
			}

			return allData;
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
		}

		return new List<TableRealtime>();
	}

	// Filtering data
	private IEnumerable<TableRealtime> GetFilteredTableData()
	{
		var allData = GetAllTableData(machineTags);

		if (!string.IsNullOrWhiteSpace(selectedTable))
		{
			allData = allData
				.Where(x => x.TableName.Equals(selectedTable, StringComparison.OrdinalIgnoreCase))
				.ToList();
		}

		if (!string.IsNullOrWhiteSpace(selectedColumn))
		{
			allData = allData
				.Where(x => x.Column.Equals(selectedColumn, StringComparison.OrdinalIgnoreCase))
				.ToList();
		}

		return allData;
	}

	private void OnRender(DataGridRenderEventArgs<TableRealtime> args)
	{
		if (args.FirstRender)
		{
			args.Grid.Groups.Add(new GroupDescriptor() { Property = "TableName" });
			StateHasChanged();
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_hubConnection != null)
		{
			await _hubConnection.DisposeAsync();
		}
	}

	// Animasi perubahan data
	private string GetValueClass(TableRealtime data)
	{
		string key = $"{data.TableName}_{data.Column}";
		return animatedKeys.Contains(key) ? "value-changed" : "";
	}

	private void DetectValueChanges()
	{
		var newTableData = GetAllTableData(machineTags);

		foreach (var item in newTableData)
		{
			string key = $"{item.TableName}_{item.Column}";
			string newValue = item.Value?.ToString() ?? "";

			if (previousValues.TryGetValue(key, out var oldValue))
			{
				if (newValue != oldValue)
				{
					animatedKeys.Add(key);
					previousValues[key] = newValue;
				}
			}
			else
			{
				previousValues[key] = newValue;
			}
		}
	}
}
