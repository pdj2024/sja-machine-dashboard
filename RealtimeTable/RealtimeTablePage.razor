@implements IDisposable
@using Radzen
@using Radzen.Blazor

<RadzenRow>
	<RadzenColumn SizeMD="12">
		<div class="d-flex flex-column gap-2">
			<p class="text-muted mt-2">
				@{
					var culture = new System.Globalization.CultureInfo("id-ID");
					string hari = culture.DateTimeFormat.GetDayName(lastUpdated.DayOfWeek);
					string tanggal = lastUpdated.ToString("dd MMMM yyyy HH.mm.ss", culture);
				}
				Terakhir update: <b>@hari, @tanggal</b>
			</p>
			<p class="text-muted mt-2">
				@* Fetch Data setiap: <b>5 detik</b> *@
				Fetch Data setiap:
				<select class="form-select d-inline-block w-auto ms-2" @onchange="OnIntervalChange">
					@foreach (var option in IntervalOptions)
					{
						<option value="@option.Value" selected="@(updateInterval == option.Value)">
							@option.Label
						</option>
					}
				</select>
			</p>
		</div>

		@* Filter DateTime *@
		<FilterDateTimeButton InitialStartDate="@StartDate" 
							 InitialEndDate="@EndDate"
							 IsLoading="@isLoading" 
							 OnFilter="ApplyDateFilter" />

		@* Table Realtiem *@
		<RadzenDataGrid @ref="Grid"
						Data="@measurementList"
						TItem="MeasurementData"
						AllowSorting="true"
						AllowPaging="false"
						AllowVirtualization="true">
			<Columns>
				<RadzenDataGridColumn TItem="MeasurementData" Property="Measurement" Title="Measurement" Width="200px" TextAlign="TextAlign.Left" />
				<RadzenDataGridColumn TItem="MeasurementData" Property="Value" Title="Value" Width="200px" TextAlign="TextAlign.Center" />
				<RadzenDataGridColumn TItem="MeasurementData" Property="Units" Title="Units" Width="100px" TextAlign="TextAlign.Center" />
			</Columns>
		</RadzenDataGrid>
	</RadzenColumn>
</RadzenRow>

@code {
	public class MeasurementData
	{
		public string Measurement { get; set; }
		public double Value { get; set; }
		public string Units { get; set; }
	}

	private RadzenDataGrid<MeasurementData> Grid;
	private List<MeasurementData> measurementList = new();
	private System.Timers.Timer updateTimer;
	private DateTime lastUpdated = DateTime.Now;
	private Random rand = new();

	private double updateInterval = 5000;

	private DateTime? StartDate = DateTime.Now.AddHours(-6);
	private DateTime? EndDate = DateTime.Now;
	private bool isLoading = false;

	private List<(string Label, double Value)> IntervalOptions = new()
	{
		("5 detik", 5000),
		("1 menit", 60000),
		("5 menit", 300000),
		("1 jam", 3600000)
	};

	protected override void OnInitialized()
	{
		GenerateDummyData();

		// updateTimer = new System.Timers.Timer(5000);
		// updateTimer.Elapsed += async (s, e) => await UpdateDataAsync();
		// updateTimer.AutoReset = true;
		// updateTimer.Enabled = true;

		SetupTimer(updateInterval);
	}

	private void SetupTimer(double interval)
	{
		updateTimer?.Dispose();
		updateTimer = new System.Timers.Timer(interval);
		updateTimer.Elapsed += async (s, e) => await UpdateDataAsync();
		updateTimer.AutoReset = true;
		updateTimer.Enabled = true;
	}

	private void OnIntervalChange(ChangeEventArgs e)
	{
		if (double.TryParse(e.Value?.ToString(), out double newInterval))
		{
			updateInterval = newInterval;
			SetupTimer(updateInterval);
			StateHasChanged();
		}
	}

	private async Task UpdateDataAsync()
	{
		await InvokeAsync(() =>
		{
			GenerateDummyData();
			lastUpdated = DateTime.Now;
			StateHasChanged();
		});
	}

	private void GenerateDummyData()
	{
		measurementList = new List<MeasurementData>
		{
			new MeasurementData { Measurement = "Temperature", Value = Math.Round(35 + rand.NextDouble() * 5, 2), Units = "°C" },
			new MeasurementData { Measurement = "Pressure", Value = Math.Round(3 + rand.NextDouble(), 2), Units = "Pa" },
			new MeasurementData { Measurement = "Flowrate", Value = Math.Round(50 + rand.NextDouble() * 15, 2), Units = "L/s" },
			new MeasurementData { Measurement = "Energy Consumption", Value = Math.Round(8 + rand.NextDouble() * 5, 2), Units = "kWh" }
		};
	}

	private async Task ApplyDateFilter((DateTime? Start, DateTime? End) range)
	{
		StartDate = range.Start;
		EndDate = range.End;

		await LoadData();
	}

	private async Task LoadData()
	{
		isLoading = true;
		// myData = await MyService.GetAll(start: StartDate, end: EndDate);
		isLoading = false;
		StateHasChanged();
	}

	public void Dispose()
	{
		updateTimer?.Dispose();
	}
}
