	// Merged Table
	public async Task ExportTablesGrid(string type)
	{
		isExport = true;
		exportProgress = 0;
		NotificationService.Notify(NotificationSeverity.Info, "Export Data", "Menyiapkan file untuk diekspor...");
		StateHasChanged();

		try
		{
			// Jika tidak ada data sama sekali
			if ((HistoryData == null || !HistoryData.Any()) && (MultiTableData == null || !MultiTableData.Any()))
			{
				NotificationService.Notify(NotificationSeverity.Warning, "Export Gagal", "Tidak ada data untuk diekspor.");
				isExport = false;
				exportProgress = 0;
				StateHasChanged();
				return;
			}

			await SimulateProgress(0, 30);

			if (SelectedFilterMode == "Tag")
			{
				if (HistoryData != null && HistoryData.Any())
				{
					await ExportSingleTable(HistoryData, "HistoryData", type);
				}
			}
			else
			{
				if (MergedTableData == null || !MergedTableData.Any())
				{
					NotificationService.Notify(NotificationSeverity.Warning, "Export Gagal", "Tidak ada data untuk diekspor.");
					isExport = false;
					exportProgress = 0;
					StateHasChanged();
