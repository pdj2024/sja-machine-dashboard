@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject NotificationService NotificationService

@inject IMachineService MachineService

<RadzenRow>
	<RadzenColumn SizeMD="12">
		<div class="card border shadow-xs mb-4">
			@* Header Table *@
			<div class="card-header border-bottom pb-0">
				<div class="d-flex flex-wrap align-items-center">
					<div>
						<h6 class="mb-0" style="font-size: 24px; font-weight: 600;">Table History</h6>
						<p class="text-sm"></p>
						@if (isExport)
						{
							<div style="margin-bottom: 10px;">
								<RadzenProgressBar Value="@exportProgress"
												   Mode="ProgressBarMode.Determinate"
												   ShowValue="true"
												   ValueTextFormat="{0}%"
												   Style="height: 10px; width: 100%;" />
							</div>
						}
					</div>
					<div class="ms-auto d-flex mb-3">
						@* Export Button *@
						<ButtonExportTable IsExporting="@isExport" OnExportClick="ExportTables" ExportOptions="@ExportOptions" />
					</div>
				</div>
			</div>

			@* Body Table *@
			<div class="card-body px-0 py-0">
				<div class="border-bottom py-3 px-3">
					@* Filter DateTime *@
					<FilterDateTimeButton InitialStartDate="@StartDate"
										  InitialEndDate="@EndDate"
										  IsLoading="@isLoading"
										  OnFilter="ApplyDateFilter" />

					@* Filter Mode: Table || Column *@
					<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.Normal" Gap="5" Style="flex-wrap: wrap !important; margin: 1rem 0rem;">
						<RadzenFormField AllowFloatingLabel="false" Text="Mode Filter">
							<RadzenDropDown @bind-Value="SelectedFilterMode"
											Data="@FilterModes"
											Change="@OnFilterModeChanged"
											Style="width:200px"
											Placeholder="Pilih mode filter..." />
						</RadzenFormField>

						@if (SelectedFilterMode == "Table")
						{
							<RadzenButton Text="Pilih Tabel" Icon="checklist" Click="OpenTableSelectorPopup" />
						}
						else if (SelectedFilterMode == "Tag")
						{
							<RadzenButton Text="Pilih Tag" Icon="checklist" Click="OpenColumnSelectorPopup" />
						}

						<RadzenButton Click="@UpdateTable" Text="Update Table" IsBusy="@isUpdateTable" Icon="refresh" Class="w-auto" />
					</RadzenStack>

					@if (SelectedFilterMode == "Tag" && SelectedTags.Any())
					{
						<div class="mb-3">
							<div class="border rounded p-3 mb-3 bg-light">
								<h6 class="fw-semibold mb-3">
									List Tag yang dipilih
								</h6>

								@foreach (var tag in SelectedTags)
								{
									<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
										<span class="ms-1">@GetColumnDisplayName(NormalizeTag(tag))</span>
									</div>
								}
							</div>
						</div>
					}

					@if (SelectedFilterMode == "Table")
					{
						<div class="mb-3">
							@if (SelectedTables != null && SelectedTables.Any())
							{
								@foreach (var tableName in SelectedTables)
								{
									var sel = tablesForUI.FirstOrDefault(t => t.Name == tableName);
									if (sel != null)
									{
										<div class="border rounded p-3 mb-3 bg-light">
											<h6 class="fw-semibold mb-3">
												List Tag dari tabel <b>@sel.Name</b>
											</h6>

											@if (sel.Columns != null && sel.Columns.Any())
											{
												@foreach (var column in sel.Columns)
												{
													<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
														<span class="ms-1">@GetColumnDisplayName(column.DisplayName)</span>
														@* <span class="ms-1">@column.DisplayName</span> *@
														@* <span class="text-muted">(@column.Description)</span> *@
													</div>
												}
											}
											else
											{
												<div class="text-muted fst-italic">
													Tabel ini belum memiliki Tag.
												</div>
											}
										</div>
									}
								}
							}
						</div>
					}

				</div>

				<div class="table-responsive p-0">
					@* Table History *@
					@if (SelectedFilterMode == "Tag" && SelectedTags.Any())
					{
						<RadzenDataGrid Data="@HistoryData"
										TItem="TableColumn"
										ColumnWidth="200px"
										AllowSorting="true"
										AllowPaging="true"
										PageSize="10"
										PageSizeOptions="@(new int[] { 10, 20, 50 })"
										PagerHorizontalAlign="HorizontalAlign.Right"
										ShowPagingSummary="true"
										Style="margin-bottom: 5rem;">

							<Columns>
								<RadzenDataGridColumn TItem="TableColumn" Property="Timestamp" Title="Timestamp" Frozen="true">
									<Template Context="data">
										@data.Timestamp.ToString("dd-MM-yyyy HH:mm:ss")
									</Template>
								</RadzenDataGridColumn>
								@foreach (var tag in HistoryData.SelectMany(h => h.Tags.Keys).Distinct())
								{
									<RadzenDataGridColumn TItem="TableColumn" Title="@GetColumnTitle(tag)">
										<Template Context="data">
											@GetColumnTitle(data.Tags[tag])
										</Template>
									</RadzenDataGridColumn>
								}
							</Columns>

							<PagingSummaryTemplate>
								<RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
								Page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount data)</b>
							</PagingSummaryTemplate>
						</RadzenDataGrid>
					}

					@* Multi Table *@
					@if (SelectedFilterMode == "Table")
					{
						@if (MultiTableData.Any())
						{
							foreach (var table in MultiTableData)
							{
								<h5 class="ms-2 mt-4 mb-2 fw-bold" style="color: #1e3a6a;">Tabel: @table.Key</h5>

								<RadzenDataGrid Data="@table.Value"
												TItem="TableColumn"
												ColumnWidth="200px"
												AllowSorting="true"
												AllowPaging="true"
												PageSize="10"
												PageSizeOptions="@(new int[] { 10, 20, 50 })"
												PagerHorizontalAlign="HorizontalAlign.Right"
												ShowPagingSummary="true"
												Style="margin-bottom: 5rem;">

									<Columns>
										<RadzenDataGridColumn TItem="TableColumn" Property="Timestamp" Title="Timestamp" Frozen="true">
											<Template Context="data">
												@data.Timestamp.ToString("dd-MM-yyyy HH:mm:ss")
											</Template>
										</RadzenDataGridColumn>

										@foreach (var tag in table.Value.SelectMany(h => h.Tags.Keys).Distinct())
										{
											<RadzenDataGridColumn TItem="TableColumn" Title="@GetColumnTitle(tag)">
												<Template Context="data">
													@GetColumnTitle(data.Tags[tag])
												</Template>
											</RadzenDataGridColumn>
										}
									</Columns>

									<PagingSummaryTemplate>
										<RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
										Page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount data)</b>
									</PagingSummaryTemplate>
								</RadzenDataGrid>
							}
						}
					}

					@* Merger Table *@
					@* @if (SelectedFilterMode == "Table")
					{
						@if (MergedTableData != null && MergedTableData.Any())
						{
							<RadzenDataGrid Data="@MergedTableData"
											TItem="TableColumn"
											ColumnWidth="200px"
											AllowSorting="true"
											AllowPaging="true"
											PageSize="10"
											PageSizeOptions="@(new int[] { 10, 20, 50 })"
											PagerHorizontalAlign="HorizontalAlign.Right"
											ShowPagingSummary="true"
											Style="margin-bottom: 5rem;">

								<Columns>
									<RadzenDataGridColumn TItem="TableColumn" Property="Timestamp" Title="Timestamp" Frozen="true">
										<Template Context="data">
											@data.Timestamp.ToString("dd-MM-yyyy HH:mm:ss")
										</Template>
									</RadzenDataGridColumn>

									@foreach (var tag in AllMergedTags)
									{
										<RadzenDataGridColumn TItem="TableColumn" Title="@tag">
											<Template Context="data">
												@if (data.Tags.TryGetValue(tag, out var value))
												{
													@value
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</Template>
										</RadzenDataGridColumn>
									}
								</Columns>

								<PagingSummaryTemplate>
									<RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
									Page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount data)</b>
								</PagingSummaryTemplate>
							</RadzenDataGrid>
						}
					} *@

				</div>
			</div>
		</div>

	</RadzenColumn>
</RadzenRow>

@code {
	private Dictionary<string, List<TableMachine>> machineTable = new();
	private Dictionary<string, List<ColumnMachine>> machineTags = new();

	private List<TableModal> Tables = new();
	private List<TableModal> tablesForUI = new List<TableModal>();
	private List<TableColumn> HistoryData = new();
	private bool ExportSelectedRowsOnly { get; set; }

	private Dictionary<string, List<TableColumn>> MultiTableData = new();
	private List<TableColumn> MergedTableData = new();
	private List<string> AllMergedTags = new();

	private HashSet<string> SelectedTables = new();
	private HashSet<string> SelectedTags = new();
	private HashSet<string> CollapsedTables = new();
	private bool isColumnSelectorVisible = false;

	// Filter mode
	private List<string> FilterModes = new() { "Tag", "Table" };
	private string SelectedFilterMode = "Table";

	private DateTime? StartDate = DateTime.Now.ToLocalTime().Date;
	private DateTime? EndDate = DateTime.Now.ToLocalTime();

	private bool isLoading = false;
	private bool isUpdateTable = false;
	private bool isExport = false;
	private double exportProgress = 0;

	private List<ButtonExportTable.ExportOption> ExportOptions = new()
	{
		new ButtonExportTable.ExportOption { Type = "csv", Text = "Export CSV", LoadingText = "Export CSV..." },
		new ButtonExportTable.ExportOption { Type = "excel", Text = "Export Excel", LoadingText = "Export Excel..." },
	};

	protected override async Task OnInitializedAsync()
	{
		await LoadData();
		base.OnInitialized();
	}

	private async Task LoadData()
	{
		try
		{
			isLoading = true;

			machineTags = await MachineService.Browse();

			// Konversi ke modal baru
			tablesForUI = machineTags.Select(kvp => new TableModal
			{
				Name = kvp.Key,
				Columns = kvp.Value.Select(tag => new ColumnModal
				{
					FullName = $"{kvp.Key}.{tag.NamaTag}",
					DisplayName = tag.NamaTag,
					Description = tag.AliasPendek
				}).ToList() ?? new List<ColumnModal>()
			}).ToList();

			// if (tablesForUI.Any())
			// {
			// 	CollapsedTables = tablesForUI.Skip(1).Select(t => t.Name).ToHashSet();

			// 	SelectedTable = tablesForUI.Select(t => t.Name).First();
			// 	OnTableSelectionChanged(SelectedTable);
			// }
		}
		catch (Exception ex)
		{
			tablesForUI = new List<TableModal>();
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task UpdateTable()
	{
		HistoryData.Clear();

		MultiTableData.Clear();
		MergedTableData.Clear();
		AllMergedTags.Clear();

		isUpdateTable = true;
		StateHasChanged();

		try
		{
			// Column Mode
			if (SelectedFilterMode == "Tag")
			{
				if (SelectedTags == null || !SelectedTags.Any())
				{
					await OpenColumnSelectorPopup();
					return;
				}

				var body = new
				{
					tgl_start = StartDate,
					tgl_finish = EndDate,
					request_data = SelectedTags.ToArray()
				};
				machineTable = await MachineService.GetTableBy(body, "tag");

				if (machineTable == null || machineTable.Count == 0)
				{
					HistoryData = new List<TableColumn>();
					StateHasChanged();
					return;
				}

				HistoryData = machineTable
					.SelectMany(kvp => kvp.Value.Select(v => new
					{
						Tag = kvp.Key,
						v.Timestamp,
						v.Value
					}))
					.GroupBy(x => x.Timestamp)
					.Select(g =>
					{
						DateTime ts;
						if (!DateTime.TryParse(g.Key, out ts))
						{
							ts = DateTime.MinValue;
						}

						var tagsDict = g
							.GroupBy(x => x.Tag)
							.ToDictionary(
								grp => grp.Key,
								grp =>
								{
									var last = grp.LastOrDefault();
									if (last == null || last.Value == null)
										return "null";
									return last.Value.ToString();
								});

						return new TableColumn
						{
							Timestamp = ts,
							Tags = tagsDict
						};
					})
					.OrderBy(x => x.Timestamp)
					.ToList();
			}
			// Table Mode
			else
			{
				if (!SelectedTables.Any())
				{
					await OpenTableSelectorPopup();
					return;
				}
				await LoadMultipleTables();
				// await LoadMultipleTablesGrid();
			}
		}
		finally
		{
			isUpdateTable = false;
			StateHasChanged();
		}
	}

	// Filter DateTime
	private void ApplyDateFilter((DateTime? Start, DateTime? End) range)
	{
		StartDate = range.Start;
		EndDate = range.End;

		StateHasChanged();
	}

	// Pilih Mode Filter
	private void OnFilterModeChanged(object value)
	{
		if (SelectedFilterMode == "Tag")
		{
			MultiTableData.Clear();
		}
		else
		{
			HistoryData.Clear();
		}
		StateHasChanged();
	}

	// Load Data Tables untuk Mode Filter "Table"
	// Multi Table
	private async Task LoadMultipleTables()
	{
		try
		{
			MultiTableData.Clear();

			foreach (var tableName in SelectedTables)
			{
				var body = new
				{
					tgl_start = StartDate,
					tgl_finish = EndDate,
					request_data = new[] { tableName }
				};
				var result = await MachineService.GetTableBy(body, "table");

				if (result != null && result.Any())
				{
					var historyData = result
						.SelectMany(kvp => kvp.Value.Select(v => new { Tag = kvp.Key, v.Timestamp, v.Value }))
						.GroupBy(x => x.Timestamp)
						.Select(g =>
						{
							DateTime ts;
							if (!DateTime.TryParse(g.Key, out ts))
							{
								ts = DateTime.MinValue;
							}

							var tagsDict = g
								.GroupBy(x => x.Tag)
								.ToDictionary(
									grp => grp.Key,
									grp =>
									{
										var last = grp.LastOrDefault();
										if (last == null || last.Value == null)
											return "null";
										return last.Value.ToString();
									});

							return new TableColumn
							{
								Timestamp = ts,
								Tags = tagsDict
							};
						})
						.OrderBy(x => x.Timestamp)
						.ToList();

					MultiTableData[tableName] = historyData;
				}
				else
				{
					MultiTableData[tableName] = new List<TableColumn>();
				}
			}
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
			MultiTableData.Clear();
		}
		finally
		{
			StateHasChanged();
		}
	}

	// Merger Table
	private async Task LoadMultipleTablesGrid()
	{
		MultiTableData.Clear();
		MergedTableData.Clear();
		AllMergedTags.Clear();

		try
		{
			var body = new
			{
				tgl_start = StartDate,
				tgl_finish = EndDate,
				request_data = SelectedTables.ToArray()
			};
			var result = await MachineService.GetTableBy(body, "table");

			foreach (var tableName in SelectedTables)
			{
				if (result != null && result.Any())
				{
					var historyData = result
						.SelectMany(kvp => kvp.Value.Select(v => new { Table = tableName, Tag = kvp.Key, v.Timestamp, v.Value }))
						.GroupBy(x => x.Timestamp)
						.Select(g =>
						{
							DateTime.TryParse(g.Key, out var ts);

							var tagsDict = g
								.GroupBy(x => x.Tag)
								.ToDictionary(
									// grp => $"{tableName}.{grp.Key}",
									grp => $"{grp.Key}",
									grp => grp.LastOrDefault()?.Value?.ToString() ?? "null"
								);

							return new TableColumn
							{
								Timestamp = ts,
								Tags = tagsDict
							};
						})
						.OrderBy(x => x.Timestamp)
						.ToList();

					MultiTableData[tableName] = historyData;
				}
			}

			var allTimestamps = MultiTableData.Values
				.SelectMany(x => x.Select(d => d.Timestamp))
				.Distinct()
				.OrderBy(x => x)
				.ToList();

			foreach (var ts in allTimestamps)
			{
				var combinedTags = new Dictionary<string, string>();

				foreach (var kvp in MultiTableData)
				{
					var tableName = kvp.Key;
					var tableData = kvp.Value.FirstOrDefault(d => d.Timestamp == ts);
					if (tableData != null)
					{
						foreach (var tag in tableData.Tags)
						{
							// var key = $"{tableName}.{tag.Key}";
							var key = $"{tag.Key}";
							combinedTags[key] = tag.Value;
						}
					}
				}

				MergedTableData.Add(new TableColumn
				{
					Timestamp = ts,
					Tags = combinedTags
				});
			}

			AllMergedTags = MergedTableData
				.SelectMany(x => x.Tags.Keys)
				.Distinct()
				.OrderBy(x => x)
				.ToList();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
			MultiTableData.Clear();
			MergedTableData.Clear();
			AllMergedTags.Clear();
		}
		finally
		{
			StateHasChanged();
		}
	}

	// Modal Pilih Kolom untuk Mode Filter "Table"
	private async Task OpenTableSelectorPopup()
	{
		var result = await DialogService.OpenAsync<DialogTableChoose>("Pilih Tabel",
			new Dictionary<string, object>
			{
				{ "AllTables", tablesForUI },
				{ "SelectedTables", SelectedTables },
				{ "OnUpdate", EventCallback.Factory.Create<HashSet<string>>(this, async (tables) =>
					{
						SelectedTables = tables;
						await UpdateTable();
					})
				}
			},
			new DialogOptions
			{
				Width = "600px",
				Resizable = true,
				Draggable = true
			}
		);

		try
		{
			if (result is HashSet<string> selected)
			{
				SelectedTables = selected;
			}
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			StateHasChanged();
		}

	}

	// Modal Pilih Kolom untuk Mode Filter "Tag"
	private async Task OpenColumnSelectorPopup()
	{
		var result = await DialogService.OpenAsync<DialogColumnChoose>("Pilih Tag",
			new Dictionary<string, object>
			{
					{ "MachineTags", machineTags },
					{ "SelectedTags", SelectedTags },
					{ "OnUpdate", EventCallback.Factory.Create<HashSet<string>>(this, async (cols) =>
						{
							SelectedTags = cols;
							await UpdateTable();
						})
					},
					{ "IsTable", true }
			},
			new DialogOptions
			{
				Width = "650px",
				Resizable = true,
				Draggable = true
			}
		);

		try
		{
			if (result is HashSet<string> selected)
			{
				SelectedTags = selected;
			}
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			StateHasChanged();
		}
	}

	// Menampilkan Kolom yang dipilih untuk Mode Filter "Tag"
	// private string GetColumnDisplayName(string fullName)
	// {
	// 	return Tables.SelectMany(t => t.Columns).FirstOrDefault(c => c.FullName == fullName)?.DisplayName ?? fullName;
	// }

	private string GetColumnTitle(string tag)
	{
		var unit = UnitCache.GetUnit(tag);
		return unit != null ? $"{tag} ({unit})" : tag;
	}

	private string GetColumnDisplayName(string tag)
	{
		var unit = UnitCache.GetUnit(tag);

		if (!string.IsNullOrWhiteSpace(unit) && unit != "null")
			return $"{tag} ({unit})";

		return tag;
	}

	private string NormalizeTag(string tag)
	{
		if (tag.Contains('.'))
			return tag.Split('.').Last();

		return tag;
	}

	// --- Export function ---
	// Multi Table
	public async Task ExportTables(string type)
	{
		isExport = true;
		exportProgress = 0;
		NotificationService.Notify(NotificationSeverity.Info, "Export Data", "Menyiapkan file untuk diekspor...");
		StateHasChanged();

		try
		{
			// Jika tidak ada data sama sekali
			if ((HistoryData == null || !HistoryData.Any()) && (MultiTableData == null || !MultiTableData.Any()))
			{
				NotificationService.Notify(NotificationSeverity.Warning, "Export Gagal", "Tidak ada data untuk diekspor.");
				isExport = false;
				exportProgress = 0;
				StateHasChanged();
				return;
			}

			await SimulateProgress(0, 30);

			// =======================
			// MODE: Column (HistoryData tunggal)
			// =======================
			if (HistoryData != null && HistoryData.Any())
			{
				await ExportSingleTable(HistoryData, "HistoryData", type);
			}
			// =======================
			// MODE: Multi-Table
			// =======================
			else if (MultiTableData != null && MultiTableData.Any())
			{
				if (type.ToLower() == "excel")
				{
					using var workbook = new ClosedXML.Excel.XLWorkbook();

					foreach (var tablePair in MultiTableData)
					{
						var tableName = tablePair.Key;
						var tableData = tablePair.Value;

						if (tableData == null || !tableData.Any())
							continue;

						var allTags = tableData
							.SelectMany(h => h.Tags.Keys)
							.Distinct()
							.ToList();

						var worksheet = workbook.Worksheets.Add(tableName.Length > 31 ? tableName[..31] : tableName);

						worksheet.Cell(1, 1).Value = "Timestamp";
						for (int i = 0; i < allTags.Count; i++)
							worksheet.Cell(1, i + 2).Value = allTags[i];

						int rowIndex = 2;
						int total = tableData.Count;

						foreach (var row in tableData)
						{
							worksheet.Cell(rowIndex, 1).Value = row.Timestamp;
							worksheet.Cell(rowIndex, 1).Style.DateFormat.Format = "dd-MM-yyyy HH.mm.ss";

							for (int i = 0; i < allTags.Count; i++)
							{
								if (row.Tags.TryGetValue(allTags[i], out var value))
									worksheet.Cell(rowIndex, i + 2).Value = value;
							}

							rowIndex++;
						}

						exportProgress = 30 + Math.Round(((rowIndex - 1) / (double)total * 60 / MultiTableData.Count));
						StateHasChanged();

						worksheet.Columns().AdjustToContents();
					}

					await SimulateProgress(exportProgress, 95);

					using var stream = new MemoryStream();
					workbook.SaveAs(stream);
					stream.Position = 0;

					var fileName = $"AllTables_{DateTime.Now:ddMMyyyyHHmmss}.xlsx";
					using var streamRef = new DotNetStreamReference(stream);
					await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
				}
				else if (type.ToLower() == "csv")
				{
					// CSV dibuat per File
					foreach (var tablePair in MultiTableData)
					{
						var tableName = tablePair.Key;
						var tableData = tablePair.Value;

						if (tableData == null || !tableData.Any())
							continue;

						var allTags = tableData
							.SelectMany(h => h.Tags.Keys)
							.Distinct()
							.ToList();

						var csv = new StringBuilder();

						csv.Append("Timestamp");
						foreach (var tag in allTags)
							csv.Append($";{tag}");
						csv.AppendLine();

						int count = 0;
						int total = tableData.Count;

						foreach (var row in tableData)
						{
							csv.Append(row.Timestamp.ToString("dd-MM-yyyy HH.mm.ss"));
							foreach (var tag in allTags)
							{
								if (row.Tags.TryGetValue(tag, out var value))
									csv.Append($";{value}");
								else
									csv.Append(";");
							}
							csv.AppendLine();

							count++;
						}

						exportProgress = 30 + Math.Round((count / (double)total * 60 / MultiTableData.Count));
						StateHasChanged();

						var bytes = Encoding.UTF8.GetBytes(csv.ToString());
						var fileName = $"{tableName}_{DateTime.Now:ddMMyyyyHHmmss}.csv";

						using var stream = new MemoryStream(bytes);
						using var streamRef = new DotNetStreamReference(stream);
						await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
					}
					await SimulateProgress(exportProgress, 95);
				}
			}

			await SimulateProgress(95, 100);
			NotificationService.Notify(NotificationSeverity.Success, "Export Selesai", $"Data berhasil diekspor ke format {type.ToUpper()}!");
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Export Gagal", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			await Task.Delay(500);
			isExport = false;
			exportProgress = 0;
			StateHasChanged();
		}
	}
