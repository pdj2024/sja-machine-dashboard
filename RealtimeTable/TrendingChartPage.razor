	// Table select event handled by RadzenDropDown binding directly (SelectedTable)
	private void OnTableChange(ChangeEventArgs e)
	{
		SelectedTable = e.Value?.ToString() ?? "";
	}

	private void UpdateChart()
	{
		ChartData.Clear();
		ChartDataNew.Clear();
		var rnd = new Random();
		var categories = Enumerable.Range(1, 8).Select(i => $"Hari {i}").ToList();

		// Column Mode
		if (SelectedFilterMode == "Column")
		{
			foreach (var full in SelectedColumns)
			{
				var colDisplay = full;
				foreach (var t in Tables)
				{
					var f = t.Columns.FirstOrDefault(c => c.FullName == full);
					if (f != null) { colDisplay = f.DisplayName; break; }
				}

				var dataList = new List<ChartItem>();
				foreach (var cat in categories)
				{
					dataList.Add(new ChartItem { Category = cat, Value = Math.Round(rnd.NextDouble() * 10000, 2) });
				}
				ChartData[colDisplay] = dataList;
			}
		}
		// Table Mode
		else
		{
			if (string.IsNullOrEmpty(SelectedTable)) return;

			var sel = tablesForUI.FirstOrDefault(t => t.Name == SelectedTable);

			if (sel == null) return;

			foreach (var col in sel.Columns)
			{
				var dataList = new List<ChartItem>();
				foreach (var cat in categories)
				{
					dataList.Add(new ChartItem { Category = cat, Value = Math.Round(rnd.NextDouble() * 10000, 2) });
				}
				ChartData[col.DisplayName] = dataList;
			}
		}
		StateHasChanged();
	}

	private void RefreshData()
	{
		isRefresh = true;
		UpdateChart();
		isRefresh = false;
		StateHasChanged();
	}

	private async Task ApplyDateFilter((DateTime? Start, DateTime? End) range)
	{
		StartDate = range.Start;
		EndDate = range.End;

		await LoadData();
	}

	private async Task LoadData()
	{
		isLoading = true;
		// myData = await MyService.GetAll(start: StartDate, end: EndDate);
		isLoading = false;
		StateHasChanged();
	}


	private Dictionary<string, List<ColumnMachine>> machineTags = new();
	private List<TableModal> tablesForUI = new List<TableModal>();

	private Dictionary<string, List<TableMachine>> machineTable = new();

	protected override async Task OnInitializedAsync()
	{
		SelectedFilterMode = "Table";
		isLoading = true;

		try
		{
			var body = new
			{
				tgl_start = "2025-10-17T00:00:00",
				tgl_finish = "2025-10-17T12:00:00",
				request_data = new[] { "iot_channel1", "iot_ramp" }
			};

			machineTable = await MachineService.GetTableBy(body, "table", latestData: false);




			machineTags = await MachineService.Browse();

			// Konversi ke modal baru
			tablesForUI = machineTags.Select(kvp => new TableModal
			{
				Name = kvp.Key,
				Columns = kvp.Value.Select(tag => new ColumnModal
				{
					FullName = $"{kvp.Key}.{tag.NamaTag}",
					DisplayName = tag.NamaTag,
					Description = tag.Deskripsi
				}).ToList() ?? new List<ColumnModal>()
			}).ToList();

			if (tablesForUI.Any())
			{
				CollapsedTables = tablesForUI.Skip(1).Select(t => t.Name).ToHashSet();
			}
		}
		catch (Exception ex)
		{
			tablesForUI = new List<TableModal>();
		}
		finally
		{
			isLoading = false;
			UpdateChart();
			StateHasChanged();
		}
	}


	private void OnFilterModeChanged(object value)
	{
		SelectedTable = null;
		isColumnSelectorVisible = false;
		StateHasChanged();
	}

	private void OnTableSelectionChanged(object value)
	{
		if (SelectedFilterMode == "Table" && value is string tableName)
		{
			var selectedTableInfo = Tables.FirstOrDefault(t => t.Name == tableName);
			if (selectedTableInfo?.Columns != null)
			{
				SelectedColumns = selectedTableInfo.Columns.Select(c => c.FullName).ToHashSet();
			}
			else
			{
				SelectedColumns.Clear();
			}
		}
		StateHasChanged();
	}

	private void ToggleColumnSelectorPopup()
	{
		isColumnSelectorVisible = !isColumnSelectorVisible;
		if (isColumnSelectorVisible && Tables.Any())
		{
			CollapsedTables = Tables.Skip(1).Select(t => t.Name).ToHashSet();
		}
	}
	private async Task OpenColumnSelectorPopup()
	{
		var result = await DialogService.OpenAsync<DialogColumnChoose>("Pilih Kolom Filter",
		   new Dictionary<string, object>() {
			   { "Tables", Tables },
			   { "InitialSelectedColumns", SelectedColumns }
		   },
		   new DialogOptions() { Width = "600px", Resizable = true, Draggable = true });

		if (result != null)
		{
			SelectedColumns = result as HashSet<string> ?? new HashSet<string>();
			StateHasChanged();
		}
	}

	private void CloseColumnSelectorPopup()
	{
		isColumnSelectorVisible = false;
	}

	private void ToggleCollapse(string tableName)
	{
		if (CollapsedTables.Contains(tableName))
			CollapsedTables.Remove(tableName);
		else
			CollapsedTables.Add(tableName);
	}

	private string GetCollapseStyle(string tableName)
	{
		return CollapsedTables.Contains(tableName) ? "transform: rotate(-90deg); transition: transform 0.2s;" : "transition: transform 0.2s;";
	}

	private void ToggleColumnSelection(string columnName, bool? isSelected)
	{
		if (isSelected == true)
			SelectedColumns.Add(columnName);
		else
			SelectedColumns.Remove(columnName);
	}

	private string GetColumnDisplayName(string fullName)
	{
		return Tables.SelectMany(t => t.Columns)
					 .FirstOrDefault(c => c.FullName == fullName)?.DisplayName ?? fullName;
	}



	// --- Export function ---
	private async Task Export(string idChart)
	{
		isExportPdf = true;
		StateHasChanged();
		await JSRuntime.InvokeVoidAsync("exportChart", idChart);
		isExportPdf = false;
		StateHasChanged();
	}

	private async Task ExportImage(string idChart, string format)
	{
		isExportImage = true;
		StateHasChanged();
		await JSRuntime.InvokeVoidAsync("exportChartImage", idChart, format);
		isExportImage = false;
		StateHasChanged();
	}
}