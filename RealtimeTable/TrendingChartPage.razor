@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject NotificationService NotificationService

@inject IMachineService MachineService

<RadzenRow>
	<RadzenColumn SizeMD="12">
		<div class="card border shadow-xs mb-4">
			@* Header Table *@
			<div class="card-header border-bottom pb-0">
				<div class="d-flex flex-wrap align-items-center">
					<div>
						<h6 class="mb-0" style="font-size: 24px; font-weight: 600;">Trending Chart</h6>
						<p class="text-sm">Lihat semua data tabel dalam tampilan diagram yang interaktif.</p>
						@if (isExport)
						{
							<div style="margin-bottom: 10px;">
								<RadzenProgressBar Value="@exportProgress"
												   Mode="ProgressBarMode.Determinate"
												   ShowValue="true"
												   ValueTextFormat="{0}%"
												   Style="height: 10px; width: 100%;" />
							</div>
						}
					</div>
					<div class="ms-auto d-flex">
						@* Export Button *@
						<ButtonExportChart IsExporting="@isExport" TargetId="chartArea" OnExportPdf="Export" OnExportImage="ExportImage" FormatImage="png" />
					</div>
				</div>
			</div>

			@* Body Table *@
			<div class="card-body px-0 py-0">
				<div class="border-bottom py-3 px-3">
					@* Filter DateTime *@
					<FilterDateTimeButton InitialStartDate="@StartDate"
										  InitialEndDate="@EndDate"
										  IsLoading="@isLoading"
										  OnFilter="ApplyDateFilter" />

					@* Filter Mode: Table || Column *@
					<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.Normal" Gap="5" Style="flex-wrap: wrap !important; margin: 1rem 0rem;">
						@* <RadzenFormField AllowFloatingLabel="false" Text="Mode Filter">
							<RadzenDropDown @bind-Value="SelectedFilterMode"
											Data="@FilterModes"
											Change="@OnFilterModeChanged"
											Style="width:200px"
											Disabled="true"
											Placeholder="Pilih mode filter..." />
						</RadzenFormField> *@

						<RadzenButton Text="Pilih Kolom" Icon="checklist" Click="OpenColumnSelectorPopup" />

						<RadzenButton Click="@UpdateChart" Text="Update Chart" IsBusy="@isUpdateChart" Icon="refresh" Class="w-auto" />
					</RadzenStack>

					@if (SelectedFilterMode == "Column" && SelectedColumns.Any())
					{
						<div class="mb-3">
							<div class="border rounded p-3 mb-3 bg-light">
								<h6 class="fw-semibold mb-3">
									List Kolom yang dipilih
								</h6>

								@foreach (var column in SelectedColumns.Select(GetColumnDisplayName))
								{
									<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
										<span class="ms-1">@column</span>
									</div>
								}
							</div>
						</div>
					}
				</div>

				<div class="table-responsive p-0">
					@* Line Chart *@
					<div id="chartArea" style="margin-bottom: 3rem;">
						<RadzenChart Style="height:400px">
							<RadzenChartTooltipOptions Shared="true" />

							@if (ChartData.Any())
							{
								@foreach (var dataset in ChartData)
								{
									<RadzenLineSeries Smooth="true"
													  Data="@dataset.Value"
													  CategoryProperty="Category"
													  Title="@dataset.Key"
													  ValueProperty="Value">
										<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
									</RadzenLineSeries>
								}

								<RadzenCategoryAxis Padding="20" Visible="false" />
								<RadzenValueAxis>
									<RadzenGridLines Visible="true" />
									<RadzenAxisTitle Text="Value" />
								</RadzenValueAxis>
							}
							else
							{
								<div class="text-muted fst-italic text-center my-3">
									Pilih tabel terlebih dahulu untuk menampilkan data chart.
								</div>
							}
						</RadzenChart>
					</div>
				</div>
			</div>
		</div>

	</RadzenColumn>
</RadzenRow>

<script>
	function exportChart(id) {
		const element = document.getElementById(id);

		html2canvas(element, { allowTaint: true, useCORS: true }).then(canvas => {
			const A4_WIDTH = 595.28;
			const width = A4_WIDTH;
			const height = (width / canvas.width) * canvas.height;
			const image = canvas.toDataURL('image/png');
			const doc = new jspdf.jsPDF('p', 'pt', 'a4');
			doc.addImage(image, 'PNG', 0, 0, width, height);
			doc.save('chart-pdf.pdf');
		});
	}

	async function exportChartImage(id, format = 'png') {
		const element = document.getElementById(id);

		const canvas = await html2canvas(element, { allowTaint: true, useCORS: true });
		const mimeType = format === 'jpg' || format === 'jpeg'
			? 'image/jpeg'
			: 'image/png';

		const image = canvas.toDataURL(mimeType);
		const link = document.createElement('a');
		link.href = image;
		link.download = `chart-image.${format}`;
		link.click();
	}

	async function downloadFileFromStream(fileName, contentStreamReference) {
		const arrayBuffer = await contentStreamReference.arrayBuffer();
		const blob = new Blob([arrayBuffer]);
		const url = URL.createObjectURL(blob);

		const anchorElement = document.createElement('a');
		anchorElement.href = url;
		anchorElement.download = fileName ?? 'download';
		anchorElement.click();
		anchorElement.remove();

		URL.revokeObjectURL(url);
	}
</script>

@code {
	public class ChartItem
	{
		public string Category { get; set; } = "";
		public double? Value { get; set; }
	}

	private Dictionary<string, List<TableMachine>> machineTable = new();
	private Dictionary<string, List<ColumnMachine>> machineTags = new();

	private List<TableModal> Tables = new();
	private List<TableModal> tablesForUI = new List<TableModal>();
	private List<TableColumn> HistoryData = new();
	private Dictionary<string, List<ChartItem>> ChartData = new();

	private string SelectedTable = "";
	private HashSet<string> SelectedColumns = new();
	private HashSet<string> CollapsedTables = new();
	private bool isColumnSelectorVisible = false;

	// Filter mode
	private List<string> FilterModes = new() { "Column" };
	private string SelectedFilterMode = "Column";

	private DateTime? StartDate = DateTime.Now.ToLocalTime().Date;
	private DateTime? EndDate = DateTime.Now.ToLocalTime();

	private bool isUpdateChart = false;
	private bool isLoading = false;
	private bool isExport = false;
	private double exportProgress = 0;

	protected override async Task OnInitializedAsync()
	{
		await LoadData();
		base.OnInitialized();
	}

	private async Task LoadData()
	{
		try
		{
			isLoading = true;

			machineTags = await MachineService.Browse();

			// Konversi ke modal baru
			tablesForUI = machineTags.Select(kvp => new TableModal
			{
				Name = kvp.Key,
				Columns = kvp.Value.Select(tag => new ColumnModal
				{
					FullName = $"{kvp.Key}.{tag.NamaTag}",
					DisplayName = tag.NamaTag,
					Description = tag.Deskripsi
				}).ToList() ?? new List<ColumnModal>()
			}).ToList();

			if (tablesForUI.Any())
			{
				CollapsedTables = tablesForUI.Skip(1).Select(t => t.Name).ToHashSet();

				SelectedTable = tablesForUI.Select(t => t.Name).First();
				OnTableSelectionChanged(SelectedTable);
			}
		}
		catch (Exception ex)
		{
			tablesForUI = new List<TableModal>();
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task UpdateChart()
	{
		HistoryData.Clear();
		ChartData.Clear();
		isUpdateChart = true;
		StateHasChanged();

		try
		{
			// Column Mode
			if (SelectedFilterMode == "Column")
			{
				if (SelectedColumns == null || !SelectedColumns.Any())
				{
					await OpenColumnSelectorPopup();
					// NotificationService.Notify(NotificationSeverity.Warning, "Kolom Tabel Belum Dipilih", "Silahkan pilih kolom terlebih dahulu!");
					return;
				}

				var body = new
				{
					tgl_start = StartDate,
					tgl_finish = EndDate,
					request_data = SelectedColumns.ToArray()
				};
				var result = await MachineService.GetChart(body);

				if (result == null || result.Count == 0)
				{
					ChartData.Clear();
					StateHasChanged();
					return;
				}

				foreach (var kvp in result)
				{
					var colDisplay = kvp.Key;

					foreach (var t in Tables)
					{
						var f = t.Columns.FirstOrDefault(c => c.FullName == kvp.Key);
						if (f != null)
						{
							colDisplay = f.DisplayName;
							break;
						}
					}

					ChartData[colDisplay] = kvp.Value
						.Select(x => new ChartItem
						{
							Category = DateTime.TryParse(x.Timestamp, out var dt)
								? dt.ToString("dd-MM-yyyy HH:mm")
								: x.Timestamp,

							Value = (x == null) ? 0.0 : x.Value
						})
						.ToList();
				}

			}
		}
		finally
		{
			isUpdateChart = false;
			StateHasChanged();
		}
	}

	// Filter DateTime
	private void ApplyDateFilter((DateTime? Start, DateTime? End) range)
	{
		StartDate = range.Start;
		EndDate = range.End;

		StateHasChanged();
	}

	// Pilih Mode Filter
	private void OnFilterModeChanged(object value)
	{
		StateHasChanged();
	}

	// Pilih Tabel di Mode Filter "Table"
	private void OnTableSelectionChanged(object value)
	{
		if (SelectedFilterMode == "Table" && value is string tableName)
		{
			var selectedTableInfo = Tables.FirstOrDefault(t => t.Name == tableName);
			if (selectedTableInfo?.Columns != null)
			{
				SelectedColumns = selectedTableInfo.Columns.Select(c => c.FullName).ToHashSet();
			}
			else
			{
				SelectedColumns.Clear();
			}
		}
		StateHasChanged();
	}

	// Modal Pilih Kolom untuk Mode Filter "Column"
	private async Task OpenColumnSelectorPopup()
	{
		var result = await DialogService.OpenAsync<DialogColumnChoose>("Pilih Kolom Filter",
			new Dictionary<string, object>
			{
				{ "MachineTags", machineTags },
				{ "SelectedColumns", SelectedColumns },
				{ "OnUpdate", EventCallback.Factory.Create<HashSet<string>>(this, async (cols) =>
					{
						SelectedColumns = cols;
						await UpdateChart();
					})
				}
			},
			new DialogOptions
			{
				Width = "650px",
				Resizable = true,
				Draggable = true
			});

		if (result is HashSet<string> selected)
		{
			SelectedColumns = selected;
			StateHasChanged();
		}
	}

	// Menampilkan Kolom yang dipilih untuk Mode Filter "Column"
	private string GetColumnDisplayName(string fullName)
	{
		return Tables.SelectMany(t => t.Columns).FirstOrDefault(c => c.FullName == fullName)?.DisplayName ?? fullName;
	}

	// --- Export function ---
	private async Task Export(string idChart)
	{
		isExport = true;
		exportProgress = 0;
		NotificationService.Notify(NotificationSeverity.Info, "Export Data", "Menyiapkan file untuk diekspor...");
		StateHasChanged();

		try
		{
			await SimulateProgress(0, 30);

			await JSRuntime.InvokeVoidAsync("exportChart", idChart);

			await SimulateProgress(95, 100);
			NotificationService.Notify(NotificationSeverity.Success, "Export Selesai", $"Data berhasil diekspor ke format PDF!");
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Export Gagal", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			await Task.Delay(500);
			isExport = false;
			exportProgress = 0;
			StateHasChanged();
		}
	}

	private async Task ExportImage((string idChart, string format) args)
	{
		isExport = true;
		exportProgress = 0;
		NotificationService.Notify(NotificationSeverity.Info, "Export Data", "Menyiapkan file untuk diekspor...");
		StateHasChanged();

		try
		{
			await SimulateProgress(0, 30);

			await JSRuntime.InvokeVoidAsync("exportChartImage", args.idChart, args.format);

			await SimulateProgress(95, 100);
			NotificationService.Notify(NotificationSeverity.Success, "Export Selesai", $"Data berhasil diekspor ke format PDF!");
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Export Gagal", $"Terjadi kesalahan: {ex.Message}");
		}
		finally
		{
			await Task.Delay(500);
			isExport = false;
			exportProgress = 0;
			StateHasChanged();
		}
	}

	private async Task SimulateProgress(double from, double to)
	{
		for (double i = from; i <= to; i += 5)
		{
			exportProgress = i;
			StateHasChanged();
			await Task.Delay(100);
		}
	}
}