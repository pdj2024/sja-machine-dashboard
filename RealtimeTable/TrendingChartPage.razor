@using Microsoft.JSInterop
@using Radzen
@using Radzen.Blazor
@using System.Text

@inject IJSRuntime JSRuntime
@inject DialogService DialogService

@inject IMachineService MachineService

<RadzenRow>
	@* Radzen Chart *@
	<RadzenColumn SizeMD=12 class="mt-4">

		@if (machineTable == null || machineTable.Count == 0)
		{
			<p>Memuat data...</p>
		}
		else
		{
			@foreach (var tag in machineTable)
			{
				<h5>@tag.Key</h5>
				<RadzenDataGrid Data="@tag.Value" TItem="TableMachine" AllowPaging="true" PageSize="5">
					<Columns>
						<RadzenDataGridColumn TItem="TableMachine" Property="Timestamp" Title="Timestamp" />
						<RadzenDataGridColumn TItem="TableMachine" Property="Value" Title="Value" />
					</Columns>
				</RadzenDataGrid>
				<br />
			}
		}



		@* Export Button *@
		<div class="d-flex flex-wrap gap-2 mb-3">
			<button type="button" class="btn btn-sm bg-success text-white" onclick="@(() => Export("chartArea"))">
				@if (isExportPdf)
				{
					<span>Export Data...</span>
				}
				else
				{
					<span>Export to PDF</span>
				}
			</button>
			<button type="button" class="btn btn-sm bg-success text-white" onclick="@(() => ExportImage("chartArea", "png"))">
				@if (isExportImage)
				{
					<span>Export Data...</span>
				}
				else
				{
					<span>Export to Image</span>
				}
			</button>
		</div>

		@* Filter DateTime *@
		<FilterDateTimeButton InitialStartDate="@StartDate"
							  InitialEndDate="@EndDate"
							  IsLoading="@isLoading"
							  OnFilter="ApplyDateFilter" />

		@* Dropdown pilih mode filter: Column / Table *@
		@* <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.Normal" Gap="5" Style="flex-wrap: wrap !important; margin: 1rem 0rem;">
			<RadzenFormField AllowFloatingLabel="false" Text="Mode Filter">
				<RadzenDropDown @bind-Value="SelectedFilterMode"
								Data="@FilterModes"
								Style="width:200px"
								Placeholder="Pilih mode filter..." />
			</RadzenFormField>

			@if (SelectedFilterMode == "Table")
			{
				<RadzenFormField AllowFloatingLabel="false" Text="Pilih Tabel">
					<RadzenDropDown @bind-Value="SelectedTable"
									Data="Tables.Select(t => t.Name).ToList()"
									Style="width:200px" />
				</RadzenFormField>
			}

			<RadzenButton Click="@UpdateChart" Text="Update Chart" Icon="refresh" Class="w-auto" />
		</RadzenStack>

		@if (SelectedFilterMode == "Column")
		{
			<div class="filter-panel mb-3 p-3 border rounded" style="background: #fff;">
				<div class="filter-title mb-2 d-flex align-items-center">
					<i class="material-symbols-rounded me-1">view_list</i>
					<span class="fw-semibold">Filter by Column</span>
				</div>

				@foreach (var table in Tables)
				{
					<div class="table-section mb-2 border rounded">
						<div class="table-header d-flex justify-content-between align-items-center p-2"
							 style="cursor: pointer; background: #f8f9fa;"
							 @onclick="@(() => ToggleCollapse(table.Name))">
							<div>
								<span class="fw-semibold">Tabel @table.Name</span>
							</div>
							<i class="material-symbols-rounded" style="@((CollapsedTables.Contains(table.Name) ? "transform: rotate(-90deg);" : "transition: transform 0.2s;"))">
								expand_more
							</i>
						</div>

						@if (!CollapsedTables.Contains(table.Name))
						{
							<div class="p-2 ps-4 bg-light border-top">
								@foreach (var column in table.Columns)
								{
									<div class="column-item mb-1 d-flex align-items-center">
										<RadzenCheckBox TValue="bool"
														Value="@(SelectedColumns.Contains(column.FullName))"
														Change="(args) => ToggleColumnSelection(column.FullName, args)" />
										<span class="ms-2">
											@column.DisplayName
											<span style="color: #1e3a6a;">(@column.Description)</span>
										</span>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>

		}
		else if (SelectedFilterMode == "Table")
		{
			<div class="mb-3">
				@if (!string.IsNullOrEmpty(SelectedTable))
				{
					var sel = Tables.FirstOrDefault(t => t.Name == SelectedTable);
					if (sel != null)
					{
						<div class="border rounded p-3 mb-3 bg-light">
							<h6 class="fw-semibold mb-3">
								List Kolom dari tabel <b>@sel.Name</b>
							</h6>

							@foreach (var column in sel.Columns)
							{
								<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
									<span class="ms-1">@column.DisplayName</span>
								</div>
							}
						</div>
					}
				}
				else
				{
					<div class="text-muted fst-italic">Pilih tabel dari dropdown untuk melihat kolomnya.</div>
				}
			</div>
		} *@

		<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.Normal" Gap="5" Style="flex-wrap: wrap !important; margin: 1rem 0rem;">
			<RadzenFormField AllowFloatingLabel="false" Text="Mode Filter">
				<RadzenDropDown @bind-Value="SelectedFilterMode"
								Data="@FilterModes"
								Change="@OnFilterModeChanged"
								Style="width:200px"
								Placeholder="Pilih mode filter..." />
			</RadzenFormField>

			@if (SelectedFilterMode == "Table")
			{
				<RadzenFormField AllowFloatingLabel="false" Text="Pilih Tabel">
					<RadzenDropDown @bind-Value="SelectedTable"
									Data="tablesForUI.Select(t => t.Name).ToList()"
									Change="@OnTableSelectionChanged"
									AllowClear="true"
									Style="width:200px" />
				</RadzenFormField>
			}
			else if (SelectedFilterMode == "Column")
			{
				@* <RadzenButton Text="Pilih Kolom" Icon="checklist" Click="ToggleColumnSelectorPopup" /> *@

				<RadzenButton Text="Pilih Kolom" Icon="checklist" Click="OpenColumnSelectorPopup" />
			}

			<RadzenButton Click="@UpdateChart" Text="Update Chart" Icon="refresh" Class="w-auto" />
		</RadzenStack>

		@if (SelectedFilterMode == "Column" && SelectedColumns.Any())
		{
			<div class="mb-3">
				<div class="border rounded p-3 mb-3 bg-light">
					<h6 class="fw-semibold mb-3">
						List Kolom yang dipilih
					</h6>

					@foreach (var column in SelectedColumns.Select(GetColumnDisplayName))
					{
						<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
							<span class="ms-1">@column</span>
						</div>
					}
				</div>
			</div>
		}

		@if (SelectedFilterMode == "Column" && isColumnSelectorVisible)
		{
			<RadzenCard class="mb-4 mx-3" Style="position: relative; z-index: 10;">
				<RadzenStack Orientation="Orientation.Vertical">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h5>Pilih Kolom untuk Filter</h5>
						<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Click="CloseColumnSelectorPopup" />
					</div>

					<div style="max-height: 400px; overflow-y: auto;">
						@if (Tables == null || !Tables.Any())
						{
							<p>Tidak ada tabel tersedia.</p>
						}
						else
						{
							@foreach (var table in Tables)
							{
								<div class="table-section mb-2 border rounded">
									<div class="table-header d-flex justify-content-between align-items-center p-2"
										 style="cursor: pointer; background: #f8f9fa;"
										 @onclick="@(() => ToggleCollapse(table.Name))">
										<div>
											<span class="fw-semibold">Tabel @table.Name</span>
										</div>
										<i class="material-symbols-rounded" style="@GetCollapseStyle(table.Name)">
											expand_more
										</i>
									</div>

									@if (!CollapsedTables.Contains(table.Name))
									{
										<div class="p-2 ps-4 bg-light border-top">
											@if (table.Columns == null || !table.Columns.Any())
											{
												<span class="text-muted fst-italic">Tidak ada kolom di tabel ini.</span>
											}
											else
											{
												@foreach (var column in table.Columns)
												{
													<div class="column-item mb-1 d-flex align-items-center">
														<RadzenCheckBox TValue="bool"
																		Value="@SelectedColumns.Contains(column.FullName)"
																		Change="(args) => ToggleColumnSelection(column.FullName, args)" />
														<span class="ms-2">
															@column.DisplayName
															<span style="color: #6c757d;">(@column.Description)</span>
														</span>
													</div>
												}
											}
										</div>
									}
								</div>
							}
						}
					</div>

					<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Class="mt-4">
						<RadzenButton Text="Tutup" Click="CloseColumnSelectorPopup" ButtonStyle="ButtonStyle.Primary" />
					</RadzenStack>
				</RadzenStack>
			</RadzenCard>
		}

		@if (SelectedFilterMode == "Table")
		{
			<div class="mb-3">
				@if (!string.IsNullOrEmpty(SelectedTable))
				{
					var sel = tablesForUI.FirstOrDefault(t => t.Name == SelectedTable);
					if (sel != null)
					{
						<div class="border rounded p-3 mb-3 bg-light">
							<h6 class="fw-semibold mb-3">
								List Kolom dari tabel <b>@sel.Name</b>
							</h6>

							@foreach (var column in sel.Columns)
							{
								<div class="d-inline-block me-2 mb-2 px-2 py-1 rounded" style="background:#D9E7FB;">
									<span class="ms-1">@column.DisplayName</span>
								</div>
							}
						</div>
					}
				}
				else
				{
					<div class="text-muted fst-italic">Pilih tabel dari dropdown untuk melihat kolomnya.</div>
				}
			</div>
		}

		@* Line Chart *@
		<div id="chartArea" style="margin-bottom: 3rem;">
			<RadzenChart Style="height:400px;">
				<RadzenChartTooltipOptions Shared="true" />

				@if (ChartDataNew.Any())
				{
					@foreach (var dataset in ChartData)
					{
						<RadzenLineSeries Smooth="true"
										  Data="@dataset.Value"
										  CategoryProperty="Category"
										  Title="@dataset.Key"
										  ValueProperty="Value">
							<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
						</RadzenLineSeries>
					}

					<RadzenCategoryAxis Padding="20" />
					<RadzenValueAxis>
						<RadzenGridLines Visible="true" />
						<RadzenAxisTitle Text="Value" />
					</RadzenValueAxis>
				}
				else
				{
					<div class="text-muted fst-italic text-center my-3">
						Pilih tabel terlebih dahulu untuk menampilkan data chart.
					</div>
				}
			</RadzenChart>
		</div>

	</RadzenColumn>
</RadzenRow>

<script>
	function exportChart(id) {
		const element = document.getElementById(id);

		html2canvas(element, { allowTaint: true, useCORS: true }).then(canvas => {
			const A4_WIDTH = 595.28;
			const width = A4_WIDTH;
			const height = (width / canvas.width) * canvas.height;
			const image = canvas.toDataURL('image/png');
			const doc = new jspdf.jsPDF('p', 'pt', 'a4');
			doc.addImage(image, 'PNG', 0, 0, width, height);
			doc.save('chart-pdf.pdf');
		});
	}

	async function exportChartImage(id, format = 'png') {
		const element = document.getElementById(id);

		const canvas = await html2canvas(element, { allowTaint: true, useCORS: true });
		const mimeType = format === 'jpg' || format === 'jpeg'
			? 'image/jpeg'
			: 'image/png';

		const image = canvas.toDataURL(mimeType);
		const link = document.createElement('a');
		link.href = image;
		link.download = `chart-image.${format}`;
		link.click();
	}

	async function downloadFileFromStream(fileName, contentStreamReference) {
		const arrayBuffer = await contentStreamReference.arrayBuffer();
		const blob = new Blob([arrayBuffer]);
		const url = URL.createObjectURL(blob);

		const anchorElement = document.createElement('a');
		anchorElement.href = url;
		anchorElement.download = fileName ?? 'download';
		anchorElement.click();
		anchorElement.remove();

		URL.revokeObjectURL(url);
	}
</script>

@code {
	public class TableModel
	{
		public string Name { get; set; } = "";
		public List<ColumnModel> Columns { get; set; } = new();
	}

	public class ColumnModel
	{
		public string FullName { get; set; } = "";
		public string DisplayName { get; set; } = "";
		public string Description { get; set; } = "";
	}

	public class ChartItem
	{
		public string Category { get; set; } = "";
		public double Value { get; set; }
	}

	private List<TableModel> Tables = new();
	private HashSet<string> SelectedColumns = new();
	private HashSet<string> CollapsedTables = new();
	private string SelectedTable = "";
	private Dictionary<string, List<ChartItem>> ChartData = new();
	private List<ChartItem> ChartDataNew = new List<ChartItem>();

	// Filter mode
	private List<string> FilterModes = new() { "Column", "Table" };
	private string SelectedFilterMode = "Table";

	private bool isColumnSelectorVisible = false;

	private DateTime? StartDate = DateTime.Now.AddHours(-6);
	private DateTime? EndDate = DateTime.Now;
	private bool isLoading = false;
	private bool isRefresh = false;

	// Export
	private bool isExportPdf = false;
	private bool isExportImage = false;

	// private void ToggleCollapse(string tableName)
	// {
	// 	if (CollapsedTables.Contains(tableName))
	// 		CollapsedTables.Remove(tableName);
	// 	else
	// 		CollapsedTables.Add(tableName);
	// }

	// private void ToggleColumnSelection(string columnFullName, bool isChecked)
	// {
	// 	if (isChecked)
	// 	{
	// 		if (!SelectedColumns.Contains(columnFullName))
	// 			SelectedColumns.Add(columnFullName);
	// 	}
	// 	else
	// 	{
	// 		SelectedColumns.Remove(columnFullName);
	// 	}
