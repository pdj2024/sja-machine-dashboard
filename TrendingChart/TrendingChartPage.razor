@using Microsoft.JSInterop
@using Radzen
@using Radzen.Blazor
@using System.Text

@inject IJSRuntime JSRuntime

<RadzenRow>
	@* Radzen Chart *@
	<RadzenColumn SizeMD=12 class="mt-4">

		@* Checkbox *@
		<div class="d-flex flex-wrap gap-2 mb-3">
			<RadzenButton Click="@(() => Export("chartCheckbox"))" IsBusy="@isExportPdf" Text="Export Chart PDF" />
			<RadzenButton Click="@(() => ExportImage("chartCheckbox", "png"))" IsBusy="@isExportPdf" Text="Export Chart Image" />
		</div>
		<div class="d-flex flex-wrap gap-2 mb-3">
			@foreach (var name in dataSets.Keys)
			{
				<RadzenButton Size="Radzen.ButtonSize.Small"
							  Click="() => ToggleDataset(name)"
							  Text="@name"
							  ButtonStyle="@(visibleDatasets.Contains(name) ? ButtonStyle.Primary : ButtonStyle.Light)"
							  Icon="@(visibleDatasets.Contains(name) ? "check" : "close")" />
			}
		</div>
		<div id="chartCheckbox">
			<RadzenChart Style="margin-bottom: 5rem; height: 400px;">
				<RadzenChartTooltipOptions Shared="true" />

				@foreach (var dataset in dataSets.Where(d => visibleDatasets.Contains(d.Key)))
				{
					<RadzenLineSeries Smooth="true"
									  Data="@dataset.Value"
									  CategoryProperty="Date"
									  Title="@dataset.Key"
									  ValueProperty="Revenue">
						<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
						<RadzenSeriesDataLabels Visible="false" />
					</RadzenLineSeries>
				}

				<RadzenCategoryAxis Padding="20" />
				<RadzenValueAxis Formatter="@FormatAsUSD">
					<RadzenGridLines Visible="true" />
					<RadzenAxisTitle Text="Revenue in USD" />
				</RadzenValueAxis>
			</RadzenChart>
		</div>


		@* Dropdown *@
		<div class="flex items-center gap-3 mb-3">
			<RadzenButton Click="@(() => Export("chartDropdown"))" IsBusy="@isExportPdf" Text="Export Chart PDF" />
			<RadzenButton Click="@(() => ExportImage("chartDropdown", "png"))" IsBusy="@isExportPdf" Text="Export Chart Image" />
		</div>
		<div class="flex items-center gap-3 mb-3">
			<label><b>Pilih Data yang Ditampilkan:</b></label>
			<RadzenDropDown TValue="List<string>"
							Data="@availableDataSets"
							@bind-Value="@selectedDataSets"
							Multiple="true"
							Placeholder="Pilih dataset..."
							Style="width: 250px" />
		</div>
		<div id="chartDropdown">
			<RadzenChart Style="margin-bottom: 5rem; height: 400px;">
				<RadzenChartTooltipOptions Shared="true" />

				@foreach (var dataset in dataSetsDropdown.Where(ds => selectedDataSets.Contains(ds.Key)))
				{
					<RadzenLineSeries Smooth="true"
									  Data="@dataset.Value"
									  CategoryProperty="Date"
									  Title="@dataset.Key"
									  ValueProperty="Revenue">
						<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
						<RadzenSeriesDataLabels Visible="false" />
					</RadzenLineSeries>
				}

				<RadzenCategoryAxis Padding="20" />
				<RadzenValueAxis Formatter="@FormatAsUSD">
					<RadzenGridLines Visible="true" />
					<RadzenAxisTitle Text="Revenue in USD" />
				</RadzenValueAxis>
			</RadzenChart>
		</div>
	</RadzenColumn>

	@* ChartJS *@
	<RadzenColumn SizeMD=12 class="mt-4">
		<div class="row mx-0">
			<div class="col-12 mb-4">
				<div class="card bg-transparent border-0 shadow-none">
					<div class="card-body bg-transparent">
						<h6 class="mb-0">Diagram</h6>
						<p class="text-sm">Contoh diagram 8 line chart</p>
						<div class="pe-2">
							<div class="chart position-relative">
								<canvas id="chart-diagram" class="chart-canvas" height="500"></canvas>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</RadzenColumn>
</RadzenRow>

<script>
	function exportChart(id) {
		const element = document.getElementById(id);

		html2canvas(element, { allowTaint: true, useCORS: true }).then(canvas => {
			const A4_WIDTH = 595.28;
			const width = A4_WIDTH;
			const height = (width / canvas.width) * canvas.height;
			const image = canvas.toDataURL('image/png');
			const doc = new jspdf.jsPDF('p', 'pt', 'a4');
			doc.addImage(image, 'PNG', 0, 0, width, height);
			doc.save('chart-pdf.pdf');
		});
	}

	async function exportChartImage(id, format = 'png') {
		const element = document.getElementById(id);

		const canvas = await html2canvas(element, { allowTaint: true, useCORS: true });
		const mimeType = format === 'jpg' || format === 'jpeg'
			? 'image/jpeg'
			: 'image/png';

		const image = canvas.toDataURL(mimeType);
		const link = document.createElement('a');
		link.href = image;
		link.download = `chart-image.${format}`;
		link.click();
	}

	async function downloadFileFromStream(fileName, contentStreamReference) {
		const arrayBuffer = await contentStreamReference.arrayBuffer();
		const blob = new Blob([arrayBuffer]);
		const url = URL.createObjectURL(blob);

		const anchorElement = document.createElement('a');
		anchorElement.href = url;
		anchorElement.download = fileName ?? 'download';
		anchorElement.click();
		anchorElement.remove();

		URL.revokeObjectURL(url);
	}
</script>

@code {
	protected override void OnInitialized()
	{
		GenerateDummyDataChartRadzen();
		visibleDatasets = dataSets.Keys.ToHashSet();

		GenerateDummyDataChartRadzenDropdown();
		availableDataSets = dataSets.Keys.ToList();
		selectedDataSets = availableDataSets.Take(3).ToList();
	}

	class DataItem
	{
		public string Date { get; set; }
		public double Revenue { get; set; }
	}
	private Dictionary<string, List<DataItem>> dataSets = new();
	private HashSet<string> visibleDatasets = new();

	string FormatAsUSD(object value)
	{
		return $"${value}";
	}

	private void GenerateDummyDataChartRadzen()
	{
		var rnd = new Random();
		string[] names = { "2023", "2024", "Product A", "Product B", "Product C", "Product D", "Region X", "Region Y" };
		var dates = Enumerable.Range(1, 8).Select(i => $"Day {i}").ToList();

		foreach (var name in names)
		{
			var list = new List<DataItem>();
			foreach (var date in dates)
			{
				list.Add(new DataItem
				{
					Date = date,
					Revenue = Math.Round(rnd.NextDouble() * 10000, 2)
				});
			}
			dataSets[name] = list;
		}
	}

	private void ToggleDataset(string name)
	{
		if (visibleDatasets.Contains(name))
			visibleDatasets.Remove(name);
		else
			visibleDatasets.Add(name);

		StateHasChanged();
	}

	private Dictionary<string, List<DataItem>> dataSetsDropdown = new();

	private List<string> availableDataSets = new();

	private List<string> selectedDataSets = new();

	private void GenerateDummyDataChartRadzenDropdown()
	{
		var rnd = new Random();
		string[] names = { "2023", "2024", "Product A", "Product B", "Product C", "Product D", "Region X", "Region Y" };
		var dates = Enumerable.Range(1, 8).Select(i => $"Day {i}").ToList();

		foreach (var name in names)
		{
			var list = new List<DataItem>();
			foreach (var date in dates)
			{
				list.Add(new DataItem
				{
					Date = date,
					Revenue = Math.Round(rnd.NextDouble() * 10000, 2)
				});
			}
			dataSetsDropdown.Add(name, list);
		}
	}


	// ~~~~~Button Export~~~~~
	private bool isExportPdf = false;

	private async Task Export(string idChart)
	{

		isExportPdf = true;
		StateHasChanged();

		await JSRuntime.InvokeVoidAsync("exportChart", idChart);

		isExportPdf = false;
		StateHasChanged();
	}

	private async Task ExportImage(string idChart, string format)
	{
		isExportPdf = true;
		StateHasChanged();

		await JSRuntime.InvokeVoidAsync("exportChartImage", idChart, format);

		isExportPdf = false;
		StateHasChanged();
	}
}