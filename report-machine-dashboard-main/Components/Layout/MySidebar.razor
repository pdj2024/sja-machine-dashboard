@inject TabService TabService
@rendermode InteractiveServer

@using Services
@using global::Services
@inject pdjService pdjService
@inject RealtimeTable.Interfaces.IMachineService MachineService
@inject NavigationManager Navigation



<RadzenSidebar Expanded="TabService.sidebarExpanded" style="z-index: 2;  margin: 0;   background-color: #f4f5f7!important; color:   #1e3a6a!important; font-weight: 500">
	<RadzenStack AlignItems="Radzen.AlignItems.Center"
				 class="rz-py-4 rz-py-lg-6"
				 Style="padding: var(--rz-panel-menu-item-padding);
                    border-bottom: var(--rz-panel-menu-item-border);
                    border-radius: 4px; /* Slightly rounded corners */
                    overflow: hidden; /* Ensure children fit within the rounded container */

border: 0; margin: 0; margin-bottom: 0em !important">

		<RadzenImage Path="@pdjService.clientLogo"
					 style="width: auto; height: 86px;
                        border-radius: 10%;" /* Make the image circular * /
					 AlternateText="Application logo">
		</RadzenImage>

		<RadzenText Text="@pdjService.clientName"
					TextStyle="Radzen.Blazor.TextStyle.Subtitle1"
					class="rz-mb-0"
					style="color:  #1a1a1a;" />
	</RadzenStack>

	<RadzenPanelMenu Style="width: 250px;" Click="(item) => OnItemClick(item)">

		<RadzenPanelMenuItem Text="Realtime" Value="@("realtime-parent")" Icon="speed" Expanded="false">
			<RadzenPanelMenuItem Text="Semua Tabel" Value="@("realtime")" Icon="dashboard" />

			@if (TableNames != null)
			{
				foreach (var table in TableNames)
				{
					<RadzenPanelMenuItem Text="@table"
										 Value="@($"realtime:{table}")"
										 Icon="grid_on"
										 Style="font-size: 0.9rem;" />
				}
			}
		</RadzenPanelMenuItem>

		<RadzenPanelMenuItem Text="History" Value="@("history")" Icon="history" />
		<RadzenPanelMenuItem Text="Chart" Value="@("chart")" Icon="show_chart" />

		@if (isAdmin)
		{
			<div style="border-bottom: 1px solid rgba(0,0,0,0.1); margin: 8px 12px;"></div>
			<RadzenPanelMenuItem Text="User" Value="@("user")" Icon="people" />
			<RadzenPanelMenuItem Text="Setting" Value="@("setting")" Icon="settings" />
			<RadzenPanelMenuItem Text="Push Data" Value="@("push-data")" Icon="cloud_upload" />
		}
	</RadzenPanelMenu>

	<br />
	<br />

	<RadzenStack AlignItems="Radzen.AlignItems.Start" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding-left: 24px">
		<RadzenText Text="by Pacific Data Jaya" TextStyle="Radzen.Blazor.TextStyle.Caption" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Left" />
		<RadzenText Text="Copyright Ⓒ 2025" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Left" />
	</RadzenStack>
</RadzenSidebar>


@code {
	private List<string> TableNames = new();

	// Cek Role Admin
	[Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; }
	private bool isAdmin = false;
	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		if (user.Identity?.IsAuthenticated == true)
		{
			isAdmin = user.IsInRole("admin");
		}

		try
		{
			var data = await MachineService.Browse();
			if (data != null)
			{
				TableNames = data.Keys.OrderBy(k => k).ToList();
			}
		}
		catch
		{
		}
	}

	protected override void OnInitialized()
	{
		TabService.OnSidebarToggle += StateHasChanged;
	}

	public void Dispose()
	{
		TabService.OnSidebarToggle -= StateHasChanged;
	}

	// Radzen
	void OnItemClick(Radzen.MenuItemEventArgs item)
	{
		var id = item.Value.ToString();
		var title = item.Text;

		if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(title))
		{
			return;
		}

		if (id == "realtime-parent")
        {
            return;
        }

		if (id == "keluar")
		{
			return;
		}

		if (id.Contains(";"))
		{
			return;
		}

		if (id == "realtime")
        {
            title = "Realtime Table";
        }
        else if (id.StartsWith("realtime:"))
        {
            var tableName = id.Split(':')[1];
            title = $"Realtime: {tableName}"; 
        }

		TabService.OpenTab(id, title);
	}
}