@rendermode InteractiveServer
@*@page "/tb-customers"

<PageTitle>TbCustomers</PageTitle>*@
<RadzenStack Style="flex-grow: 1; margin-top: 0.5em; width: 100%; overflow: auto; gap: 0; padding: 1.25rem ">
    @*<RadzenRow AlignItems="AlignItems.Center">
    <RadzenColumn Size="12" SizeMD="6">
    <RadzenText Text="TbCustomers" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">v
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
    <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
    <RadzenSplitButtonItem Text="CSV" Value="csv" />
    </RadzenSplitButton>
    <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
    </RadzenStack>
    </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />*@
    <RadzenRow AlignItems="AlignItems.Center" Style="margin-bottom: 1.2em;  ">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0rem">
                <RadzenText Text="Data Pelanggan" TextStyle="TextStyle.H5" TagName="TagName.H1" style="margin-right: 0.75rem; color: black; margin-top: 0.25em" />
                <RadzenButton Variant="Variant.Text" Text="Refresh" Size="Radzen.ButtonSize.Small" Icon="sync" Style="background-color: transparent; color: #1e3a6a;  box-shadow: 0px 0px 4px rgba(0,0,0, 0.2); " Visible="true" Click="@BtnRefreshClick" class="custom-button" />
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Disabled="@BtnTambahIsDisabled" Icon="add_circle_outline" Text="Tambah Item" Click="@AddButtonClick" Variant="Variant.Flat" Style="@(BtnTambahIsDisabled ?
              @BtnTambahStyleDisabled :
               @BtnTambahStyleEnabled)" />
                @*<RadzenButton Icon="@columnToggleIcon" Text="@columnToggleText" Click="@AddButtonClick" Style="background-color: transparent; color: #1e3a6a; " />*@

                <RadzenSplitButton Visible="@BtnActionIsVisible" Text="Aksi Katalog" Click=@(args => SplitOnClick(args, "SplitButton with text"))>
                    <ChildContent>
                     
                        <RadzenSplitButtonItem Text="Cetak" Value="Cetak" Icon="print" />
                        <RadzenSplitButtonItem Text="Import" Value="Import" Icon="library_add" />
                        <RadzenSplitButtonItem Text="Export" Value="Export" Icon="exit_to_app" />

                      
                    </ChildContent>

                </RadzenSplitButton>
                

            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow AlignItems="AlignItems.Center" Style="margin-bottom: 1em; " Gap="0.25em">

        <!-- Dropdown field -->
        <RadzenColumn Size="12" SizeSM="2">

            <RadzenFormField Text="Kriteria" Style="font-size: 15px; width: 100%" AllowFloatingLabel="false">
                <RadzenDropDown @bind-Value="@selectedFilter"
                                Change="OnFilterChanged"
                                Data="@(new List<string> { "Semua", "Aktif", "Non Aktif" })" />


            </RadzenFormField>

        </RadzenColumn>

        <!-- Search field -->
        <RadzenColumn Size="12" SizeSM="10">

            <RadzenRow Gap="0.25em" Style="display: flex!important; align-items: end!important;">
               <RadzenFormField Text="Pencarian" Style="font-size: 15px; width: 45%; " AllowFloatingLabel="false">
                    <RadzenTextBox @oninput="(e => OnTextChanged(e.Value.ToString()))" />

                </RadzenFormField>
                @*<DxTextBox @oninput="(e => OnTextChanged(e.Value.ToString()))" style="width: 45%; height: 38px; border-radius: 0!important" />*@

                <RadzenFormField>
                    <RadzenButton Icon="@columnToggleIcon" Text="@columnToggleText" Click="@ToggleButtonClick" Style="background-color: transparent; color: #1e3a6a; width: 20%; opacity: 0.7 " />
                </RadzenFormField>
            </RadzenRow>
        </RadzenColumn>

    </RadzenRow>





    <RadzenRow>
        <RadzenColumn SizeMD=12>
            <div Style="overflow: auto; height: 59vh; background-color: blue!important">
                <DxGrid @ref="devGrid" Data="@tbListData"  ColumnResizeMode="GridColumnResizeMode.NextColumn" TextWrapEnabled="false" FocusedRowEnabled="true" HighlightRowOnHover="true"
                        CustomizeElement="Grid_CustomizeElement" SearchText="@GridSearchText" VirtualScrollingEnabled="true"
                RowClick="EditRow"
                
                @oncontextmenu:preventDefault>

                    <Columns>
                       
                        <!-- Nama Perusahaan -->
                        <DxGridDataColumn FieldName="nm_cussup" Caption="Nama Perusahaan" Width="200px" />

                        <!-- Kode -->
                        <DxGridDataColumn FieldName="no_cussup" Caption="Kode" Width="100px" />

                        <!-- Alamat -->
                        <DxGridDataColumn FieldName="alamat" Caption="Alamat" Width="300px" />

                        <!-- Kota -->
                        <DxGridDataColumn FieldName="kota" Caption="Kota" Width="150px" />

                        <!-- Telpon -->
                        <DxGridDataColumn FieldName="telpon" Caption="Telpon" Width="150px" />

                        <!-- Nama Pemilik -->
                        <DxGridDataColumn FieldName="owner" Caption="Nama Pemilik" Width="200px" />

                        <!-- Email -->
                        <DxGridDataColumn FieldName="email" Caption="Email" Width="200px" />

                        <!-- Kontak -->
                        <DxGridDataColumn FieldName="kontak" Caption="Kontak" Width="100px" />

                        <!-- Kelurahan -->
                        <DxGridDataColumn FieldName="kelurahan" Caption="Kelurahan" Width="150px" />

                        <!-- Kecamatan -->
                        <DxGridDataColumn FieldName="kecamatan" Caption="Kecamatan" Width="150px" />

                        <!-- Kode Pos -->
                        <DxGridDataColumn FieldName="kodepos" Caption="Kode Pos" Width="150px" />

                        <!-- No NPWP -->
                        <DxGridDataColumn FieldName="no_npwp" Caption="No NPWP" Width="300px" />

                        <!-- Nama NPWP -->
                        <DxGridDataColumn FieldName="nama_npwp" Caption="Nama NPWP" Width="150px" />

                        <!-- Alamat NPWP -->
                        <DxGridDataColumn FieldName="alamat_npwp" Caption="Alamat NPWP" Width="150px" />

                        <!-- Kota NPWP -->
                        <DxGridDataColumn FieldName="kota_npwp" Caption="Kota NPWP" Width="150px" />

                        <!-- Plafon -->
                        <DxGridDataColumn FieldName="tempo" Caption="Tempo" Width="150px" DisplayFormat="N0" />

                        <!-- Plafon -->
                        <DxGridDataColumn FieldName="plafon" Caption="Plafon" Width="150px" DisplayFormat="N0" />

                        <!-- Catatan -->
                        <DxGridDataColumn FieldName="keterangan" Caption="Catatan" Width="300px" />

                        <!-- Aktif -->
                        <DxGridDataColumn FieldName="aktif" Caption="Aktif" Width="50px" />

                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FooterColumnName="nm_cussup" DisplayText="Jumlah: {0}" />
                       
                    </TotalSummary>
                    <EmptyDataAreaTemplate>
                        <b>@pdjService.GetEmptyDataAreaMessage(context.Grid)</b>
                    </EmptyDataAreaTemplate>
                   
                </DxGrid>
                
                @*<GridContextMenuContainer Grid="devGrid" @ref="ContextMenuContainer" RowContextMenuItems="contextMenuItems"
                                          OnRowMenuItemClick="HandleRowMenuItemClick" />*@
                
              

               
            </div>

        </RadzenColumn>

    </RadzenRow>
</RadzenStack>
