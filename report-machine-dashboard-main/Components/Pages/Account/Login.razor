@using Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject NavigationManager navigationManager
@using Services


<div style="height: 100vh; display: flex; justify-content: center; align-items: center; background-size: cover; background-repeat: no-repeat;">
	<div style="@ContainerStyle" class="box-form">
		<EditForm Model="Model" OnValidSubmit="Authenticate" FormName="LoginForm" style="width: 100%; padding: 1.5em">
			<DataAnnotationsValidator />
			<!--<div style="@HeaderStyle">
				<h3 style="@HeaderTextStyle">LOGIN</h3>
			</div>-->
			@* Tulisan Report Machine dibaut animasi seperti ketikan *@
			<div style="@HeaderStyle">
				<img src="@pdjService.clientLogo" alt="Company Logo" style="max-width: 150px; margin-bottom: 10px;" />
				@* <h3 style="@HeaderTextStyle">@pdjService.clientName</h3> *@
				<div class="typewriter">
					<h3 style="@HeaderTextStyle" class="typing-text">@pdjService.clientName</h3>
				</div>
			</div>

			<div style="@FormGroupStyle">
				<label for="UserName" style="@LabelStyle">Username</label>
				<InputText @bind-Value="Model.UserName" id="UserName" style="@InputStyle" placeholder="Enter your username" />
				<!-- <ValidationMessage For="() => Model.UserName" />-->
			</div>
			<div style="@FormGroupStyle">
				<label for="Password" style="@LabelStyle">Password</label>
				<InputText @bind-Value="Model.Password" id="Password" style="@InputStyle" placeholder="Enter your password" type="password" />
				<!-- <ValidationMessage For="() => Model.Password" />-->
			</div>
			<div style="@ErrorMessageStyle">
				<span>@errorMessage</span>
			</div>
			<div style="@FormGroupStyle">
				<button type="submit" style="@ButtonStyle" onmouseover="this.style.backgroundColor='@ButtonHoverStyle'" onmouseout="this.style.backgroundColor='#1e3a6a'">Login</button>
			</div>
		</EditForm>
	</div>
</div>

