	private async Task Authenticate()
	{
		/* if (Model.UserName == "" ||
          Model.Password == "")
          {

          errorMessage = "Semua field harus terisi";

        return;
        }*/

		// Initialize dictionary
		Dictionary<string, List<string>> masUserMenu = new Dictionary<string, List<string>>();

		// Add an entry to the dictionary
		// masUserMenu.Add("admin24", new List<string> { "VIEW_TAGIHAN", "ADD_TAGIHAN" });
		masUserMenu.Add("demo", new List<string> { "VIEW_TAGIHAN", "ADD_TAGIHAN" });
		//  masUserMenu.Add("admin3", new List<string> { "VIEW_TAGIHAN" });

		string passwordNya = "inidemo";

		if (!masUserMenu.ContainsKey(Model.UserName))
		{
			errorMessage = "Invalid User Name or Password";
			return;
		}

		if (Model.UserName == "demo")
		{
			if (Model.Password != passwordNya)
			{
				errorMessage = "Invalid User Name or Password";
				return;
			}
		}


		var claims = new List<Claim>
		{
			new Claim(ClaimTypes.Name, Model.UserName)
		};
		// Add Policies

		/*var UserAccountPolicies = new List<UserAccountPolicy>
            {
            new UserAccountPolicy { UserAccountId = 1, IsEnabled = true },
            new UserAccountPolicy { UserAccountId = 2, IsEnabled = false },
            new UserAccountPolicy { UserAccountId = 3, IsEnabled = true }
        };
        var userAccountPolicies = UserAccountPolicies;
        foreach (var userAccountPolicy in userAccountPolicies)
            claims.Add(new Claim(userAccountPolicy.UserPolicy, "true"));*/

		//  var thisUsersAccountPolicies = new List<string> { "VIEW_PRODUCT", "ADD_PRODUCT" }; //  ini list access yg dia punya
		var thisUsersAccountPolicies = masUserMenu[Model.UserName];
		foreach (var userAccountPolicy in thisUsersAccountPolicies)
		{

			claims.Add(new Claim(userAccountPolicy, "true"));
		}

		var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
		var principal = new ClaimsPrincipal(identity);
		await HttpContext?.SignInAsync(principal);

		navigationManager.NavigateTo("/");



	}
