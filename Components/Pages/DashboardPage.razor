@rendermode InteractiveServer

@*@page "/tb-customers"
<PageTitle>TbCustomers</PageTitle>*@

<RadzenStack Style="flex-grow: 1; margin-top: 0.5em; width: 100%; overflow: auto; gap: 0; padding: 1.25rem ">
	<RadzenRow AlignItems="AlignItems.Center" Style="margin-bottom: 1.2em;  ">
		<RadzenColumn Size="12" SizeMD="6">
			<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0rem">
				<RadzenText Text="Halaman Dashboard" TextStyle="TextStyle.H5" TagName="TagName.H1" style="margin-right: 0.75rem; color: black; margin-top: 0.25em" />
			</RadzenStack>
		</RadzenColumn>
		<RadzenColumn Size="12" SizeMD="6">
			<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem"></RadzenStack>
		</RadzenColumn>
	</RadzenRow>

	<RadzenRow>
		@* Table Real-time *@
		<RadzenColumn SizeMD="12">
			<div class="d-flex flex-column gap-2">
				<h4>Live Measurement Table</h4>
				<p class="text-muted mt-2">
					Terakhir update: <b>@lastUpdated.ToString("HH:mm:ss")</b>
				</p>
			</div>
			<DxGrid @ref="Grid"
					Data="@measurementList"
					KeyFieldName="Measurement"
					AllowSort="true"
					VirtualScrollingEnabled="true"
					TextWrapEnabled="false"
					HighlightRowOnHover="true"
					style="height: fit-content !important;">
				<Columns>
					<DxGridDataColumn FieldName="Measurement" Caption="Measurement" MinWidth="200" TextAlignment="GridTextAlignment.Left" CaptionAlignment="GridTextAlignment.Center" />
					<DxGridDataColumn FieldName="Value" Caption="Value" MinWidth="200" TextAlignment="GridTextAlignment.Center" CaptionAlignment="GridTextAlignment.Center" />
					<DxGridDataColumn FieldName="Units" Caption="Units" MinWidth="100" TextAlignment="GridTextAlignment.Center" CaptionAlignment="GridTextAlignment.Center" />
				</Columns>
			</DxGrid>
		</RadzenColumn>
	</RadzenRow>

	<RadzenRow>
		@* Table History *@
		<RadzenColumn SizeMD="12" class="mt-4">
			<div class="d-flex flex-column gap-2">
				<div class="d-flex align-items-center justify-content-start jus gap-2">
					<h4>Table History</h4>
					<button type="button" class="btn btn-sm bg-success text-white" @onclick="RefreshData">
						@if (isRefresh)
						{
							<span>Memperbarui Data...</span>
						}
						else
						{
							<span>Refresh</span>
						}
					</button>
					<button type="button" class="btn btn-sm bg-success text-white" @onclick="ExportCsv_Click">
						@if (isRefreshExport)
						{
							<span>Memperbarui Data...</span>
						}
						else
						{
							<span>Export to CSV</span>
						}
					</button>
				</div>
				<div class="d-flex align-items-center gap-3 mb-3">
					<RadzenDatePicker @bind-Value="StartDate" ShowTime="true" ShowSeconds="true" Name="StartDate" AllowClear="true" ShowButton="false" class="w-100" />
					<span>to</span>
					<RadzenDatePicker @bind-Value="EndDate" ShowTime="true" ShowSeconds="true" Name="StartDate" AllowClear="true" ShowButton="false" class="w-100" />
				</div>
			</div>
			<DxGrid @ref="Grid"
					Data="@HistoryData"
					KeyFieldName="Measurement"
					AllowSort="true"
					VirtualScrollingEnabled="true"
					TextWrapEnabled="false"
					HighlightRowOnHover="true"
					style="height: 300px !important;">
				<Columns>
					<DxGridDataColumn FieldName="Measurement" Caption="Measurement" MinWidth="200" TextAlignment="GridTextAlignment.Left" CaptionAlignment="GridTextAlignment.Center" />
					<DxGridDataColumn FieldName="Value" Caption="Value" MinWidth="200" TextAlignment="GridTextAlignment.Center" CaptionAlignment="GridTextAlignment.Center" />
					<DxGridDataColumn FieldName="Units" Caption="Units" MinWidth="100" TextAlignment="GridTextAlignment.Center" CaptionAlignment="GridTextAlignment.Center" />
					<DxGridDataColumn FieldName="Timestamp" Caption="Timestamp" MinWidth="100" TextAlignment="GridTextAlignment.Left" CaptionAlignment="GridTextAlignment.Center" />
				</Columns>
			</DxGrid>
		</RadzenColumn>
	</RadzenRow>

	<RadzenRow>
		@* Radzen Chart *@
		<RadzenColumn SizeMD=12 class="mt-4">

			@* Checkbox *@
			<div class="d-flex flex-wrap gap-2 mb-3">
				@foreach (var name in dataSets.Keys)
				{
					<RadzenButton Size="Radzen.ButtonSize.Small"
								  Click="() => ToggleDataset(name)"
								  Text="@name"
								  ButtonStyle="@(visibleDatasets.Contains(name) ? ButtonStyle.Primary : ButtonStyle.Light)"
								  Icon="@(visibleDatasets.Contains(name) ? "check" : "close")" />
				}
			</div>
			<RadzenChart Style="margin-bottom: 5rem; height: 400px;">
				<RadzenChartTooltipOptions Shared="true" />

				@foreach (var dataset in dataSets.Where(d => visibleDatasets.Contains(d.Key)))
				{
					<RadzenLineSeries Smooth="true"
									  Data="@dataset.Value"
									  CategoryProperty="Date"
									  Title="@dataset.Key"
									  ValueProperty="Revenue">
						<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
						<RadzenSeriesDataLabels Visible="false" />
					</RadzenLineSeries>
				}

				<RadzenCategoryAxis Padding="20" />
				<RadzenValueAxis Formatter="@FormatAsUSD">
					<RadzenGridLines Visible="true" />
					<RadzenAxisTitle Text="Revenue in USD" />
				</RadzenValueAxis>
			</RadzenChart>


			@* Dropdown *@
			<div class="flex items-center gap-3 mb-3">
				<label><b>Pilih Data yang Ditampilkan:</b></label>
				<RadzenDropDown TValue="List<string>"
								Data="@availableDataSets"
								@bind-Value="@selectedDataSets"
								Multiple="true"
								Placeholder="Pilih dataset..."
								Style="width: 250px" />
			</div>
			<RadzenChart Style="margin-bottom: 5rem; height: 400px;">
				<RadzenChartTooltipOptions Shared="true" />

				@foreach (var dataset in dataSetsDropdown.Where(ds => selectedDataSets.Contains(ds.Key)))
				{
					<RadzenLineSeries Smooth="true"
									  Data="@dataset.Value"
									  CategoryProperty="Date"
									  Title="@dataset.Key"
									  ValueProperty="Revenue">
						<RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
						<RadzenSeriesDataLabels Visible="false" />
					</RadzenLineSeries>
				}

				<RadzenCategoryAxis Padding="20" />
				<RadzenValueAxis Formatter="@FormatAsUSD">
					<RadzenGridLines Visible="true" />
					<RadzenAxisTitle Text="Revenue in USD" />
				</RadzenValueAxis>
			</RadzenChart>
		</RadzenColumn>

		@* ChartJS *@
		<RadzenColumn SizeMD=12 class="mt-4">
			<div class="row mx-0">
				<div class="col-12 mb-4">
					<div class="card bg-transparent border-0 shadow-none">
						<div class="card-body bg-transparent">
							<h6 class="mb-0">Diagram</h6>
							<p class="text-sm">Contoh diagram 8 line chart</p>
							<div class="pe-2">
								<div class="chart position-relative">
									<canvas id="chart-diagram" class="chart-canvas" height="500"></canvas>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</RadzenColumn>
	</RadzenRow>
</RadzenStack>
