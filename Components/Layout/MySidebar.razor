    protected override void OnInitialized()
    {
        TabService.OnSidebarToggle += StateHasChanged; // Subscribe to updates
    }

    public void Dispose()
    {
        TabService.OnSidebarToggle -= StateHasChanged; // Unsubscribe to prevent memory leaks
    }
   
    void OnItemClick(MenuItemClickEventArgs e)
    {

        var title = e.ItemInfo.Text;
        var id = e.ItemInfo.Name;

        if (title != null && id != null)
        {
            if (id == "keluar")
            {
                return;
            }
            if (id.Contains(";")) // bukan leave nodes
            {
                return;
            }


            TabService.OpenTab(id, title);

        }

    }

}